# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://athenis:password@localhost:5432/athenis_db

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-chars-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-chars-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256-GCM — must be exactly 32 chars) ───────────────
ENCRYPTION_KEY=replace-with-exactly-32-char-key!

# ── TOTP ──────────────────────────────────────────────────────────────
TOTP_ISSUER=Athenis

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
