# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://athenis:password@localhost:5432/athenis_db

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-chars-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-chars-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256-GCM — must be exactly 32 chars) ───────────────
ENCRYPTION_KEY=replace-with-exactly-32-char-key!

# ── TOTP ──────────────────────────────────────────────────────────────
TOTP_ISSUER=Athenis

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email / SMTP ───────────────────────────────────────────────────────
# Si non configuré, les e-mails sont loggués dans la console (mode dev)
# Exemples de providers : Brevo (ex-Sendinblue), Mailgun, Resend, Gmail
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-password
SMTP_FROM=Athenis <noreply@athenis.io>

# ── Monitoring des erreurs — Sentry ───────────────────────────────────
# Créer un projet sur https://sentry.io (gratuit jusqu'à 5k erreurs/mois)
# DSN disponible dans Paramètres > Clés du SDK
SENTRY_DSN=

# ── Analytics comportemental — PostHog ────────────────────────────────
# Créer un projet sur https://eu.posthog.com (gratuit jusqu'à 1M events/mois)
# Clé disponible dans Paramètres de projet > Clé API
VITE_POSTHOG_KEY=
# Hôte EU (données hébergées en Europe — recommandé RGPD)
VITE_POSTHOG_HOST=https://eu.i.posthog.com
