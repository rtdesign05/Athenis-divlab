# ── Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
# Aligne npm sur la version qui a généré package-lock.json (11.x)
RUN npm install -g npm@11

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/backend/package.json ./apps/backend/

# --ignore-scripts : le postinstall du backend lance "prisma generate" qui
# a besoin du schema.prisma, pas encore copié à cette étape. On le lance
# manuellement après avoir copié les sources.
RUN npm ci --workspace=apps/backend --workspace=packages/shared-types --ignore-scripts

COPY packages/shared-types/ ./packages/shared-types/
COPY apps/backend/ ./apps/backend/

RUN npm run build -w packages/shared-types
RUN npm run prisma:generate -w apps/backend
RUN npm run build -w apps/backend

# ── Runtime ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
# Aligne npm sur la version qui a généré package-lock.json (11.x)
RUN npm install -g npm@11

ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/backend/package.json ./apps/backend/

# --ignore-scripts : on récupère le client Prisma déjà généré depuis le
# builder (voir COPY plus bas), pas besoin de relancer prisma generate ici.
RUN npm ci --workspace=apps/backend --workspace=packages/shared-types --omit=dev --ignore-scripts

COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY apps/backend/prisma ./apps/backend/prisma

EXPOSE 3001
CMD ["node", "apps/backend/dist/index.js"]
