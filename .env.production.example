# =============================================================================
# Athenis — Variables d'environnement PRODUCTION
# Copiez ce fichier vers .env et remplissez chaque valeur.
#
# Génération des secrets (exécuter sur le serveur) :
#   JWT_SECRET          → openssl rand -hex 32
#   JWT_REFRESH_SECRET  → openssl rand -hex 32
#   ENCRYPTION_KEY      → openssl rand -hex 16   (exactement 32 chars hex = 16 bytes)
#   POSTGRES_PASSWORD   → openssl rand -base64 24 | tr -d '/'
# =============================================================================

# ── Base de données ────────────────────────────────────────────────────────────
# Le mot de passe doit correspondre à POSTGRES_PASSWORD ci-dessous
DATABASE_URL=postgresql://athenis:CHANGE_ME_DB_PASSWORD@postgres:5432/athenis_db
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── JWT ────────────────────────────────────────────────────────────────────────
# Générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Chiffrement AES-256 (exactement 32 caractères) ───────────────────────────
# Générer : openssl rand -hex 16   (donne 32 chars hexadécimaux)
ENCRYPTION_KEY=CHANGE_ME_32CHAR_ENCRYPTION_KEY!

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://CHANGE_ME_YOUR_DOMAIN.com

# ── Limite de taux ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── TOTP (authentification à deux facteurs) ───────────────────────────────────
TOTP_ISSUER=Athenis

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Provider recommandé : Brevo (gratuit jusqu'à 300 emails/jour)
# Inscription : https://www.brevo.com — Paramètres → Clés SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER@domain.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=Athenis <noreply@CHANGE_ME_YOUR_DOMAIN.com>

# ── Sauvegardes ───────────────────────────────────────────────────────────────
# Répertoire où stocker les sauvegardes pg_dump
BACKUP_DIR=/var/backups/athenis
# Nombre de jours de rétention
BACKUP_RETENTION_DAYS=30

# ── Monitoring des erreurs — Sentry (optionnel) ───────────────────────────────
# Créer un projet sur https://sentry.io (gratuit jusqu'à 5k erreurs/mois)
SENTRY_DSN=

# ── Analytics — PostHog (optionnel) ──────────────────────────────────────────
# Hébergé en Europe pour conformité RGPD
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
