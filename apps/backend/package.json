{
  "name": "@athenis/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx --env-file=../../.env prisma/seed.ts",
    "seed:reset-passwords": "node --env-file=../../.env prisma/reset-demo-passwords.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@athenis/shared-types": "*",
    "@prisma/client": "^5.15.0",
    "@sentry/node": "^9.0.0",
    "@types/multer": "^2.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.1",
    "pdf-parse": "^2.4.5",
    "posthog-node": "^5.31.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.4",
    "stripe": "^17.7.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.0",
    "prisma": "^5.15.0",
    "supertest": "^7.2.2",
    "tsx": "^4.15.7",
    "typescript": "*",
    "vitest": "^2.1.0",
    "vitest-mock-extended": "^2.0.2"
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  }
}
