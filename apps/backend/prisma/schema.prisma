// ─────────────────────────────────────────
// COMPTABILITÉ — EMPRUNTS (classe 16)
// ─────────────────────────────────────────

enum LoanAmortType {
  CONSTANT_PAYMENT      // mensualité constante (annuité française)
  CONSTANT_PRINCIPAL    // amortissement linéaire
  IN_FINE               // remboursement du capital à l'échéance
  BULLET                // remboursement unique (capital + intérêts à l'échéance)
}

enum LoanStatus {
  ACTIVE
  REPAID
  IN_DEFAULT
}

// Modèle d'emprunt (compte SYSCOHADA 16x / PCG 16x).
// Le tableau d'amortissement est calculé à la volée à partir des paramètres.
model Loan {
  id               String        @id @default(cuid())
  companyId        String        @map("company_id")
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reference        String        // identifiant interne ex : EMP-2026-001
  name             String        // libellé court
  lender           String        // prêteur (banque, organisme)

  principal        Decimal       @db.Decimal(15, 2)  // capital emprunté
  rate             Decimal       @db.Decimal(7, 4)   // taux annuel nominal (0.085 = 8.5 %)
  durationMonths   Int           @map("duration_months")

  startDate        DateTime      @map("start_date")
  firstPaymentDate DateTime      @map("first_payment_date")

  amortType        LoanAmortType @default(CONSTANT_PAYMENT) @map("amort_type")
  currency         String        @default("XAF")

  account          String?       // compte comptable lié (ex : 162000000)
  bankAccount      String?       @map("bank_account") // compte trésorerie associé (ex : 521000000)
  interestAccount  String?       @map("interest_account") // compte de charge (ex : 671000000)

  status           LoanStatus    @default(ACTIVE)
  notes            String?       @db.Text

  createdBy        String?       @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@map("loans")
}
