  event      String
  actorName  String?       @map("actor_name")
  actorEmail String?       @map("actor_email")
  actorIp    String?       @map("actor_ip")
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([contractId])
  @@index([createdAt])
  @@map("contract_audit_logs")
}

model LegalAlert {
