generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// UTILISATEURS
// ─────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  atheisNumber   String?      @unique @map("athenis_number")

  // Identité
  nom            String
  prenom         String?
  email          String       @unique
  passwordHash   String       @map("password_hash")
  telephone      String?
  avatarUrl      String?      @map("avatar_url")

  // Auth
  twoFASecret    String?      @map("two_fa_secret")
  twoFAEnabled   Boolean      @default(false) @map("two_fa_enabled")
  failedAttempts Int          @default(0) @map("failed_attempts")
  lockedUntil    DateTime?    @map("locked_until")
  lastLoginAt    DateTime?    @map("last_login_at")
  isActive       Boolean      @default(true) @map("is_active")

  // Type de compte
  accountType    AccountType  @map("account_type")

  // Rôle global sur la plateforme
  platformRole   PlatformRole @default(USER) @map("platform_role")

  // Lien selon le type (un seul sera non-null)
  personalProfile PersonalProfile?
  companyMember   CompanyMember?
  cabinetMember   CabinetMember?

  // Tokens & logs
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([accountType])
  @@map("users")
}

enum AccountType {
  PERSONAL
  COMPANY
  CABINET
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// COMPTEUR NUMÉROS ATHENIS
// ─────────────────────────────────────────

model AtheisCounter {
  id         String      @id @default(cuid())
  type       AccountType @unique
  lastNumber Int         @default(0) @map("last_number")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("athenis_counters")
}

// ─────────────────────────────────────────
// PROFIL PERSONNEL
// ─────────────────────────────────────────

model PersonalProfile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  revenus    PersonalRevenu[]
  depenses   PersonalDepense[]
  comptesBanc PersonalCompte[]
  objectifs  PersonalObjectif[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("personal_profiles")
}

model PersonalRevenu {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  profile   PersonalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  libelle   String
  montant   Decimal         @db.Decimal(15, 2)
  categorie String
  date      DateTime
  recurrent Boolean         @default(false)
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([profileId])
  @@map("personal_revenus")
}

model PersonalDepense {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  profile   PersonalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  libelle   String
  montant   Decimal         @db.Decimal(15, 2)
  categorie String
  date      DateTime
  recurrent Boolean         @default(false)
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([profileId])
  @@map("personal_depenses")
}

model PersonalCompte {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  profile   PersonalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nom       String
  type      String
  solde     Decimal         @db.Decimal(15, 2) @default(0)
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([profileId])
  @@map("personal_comptes")
}

model PersonalObjectif {
  id            String          @id @default(cuid())
  profileId     String          @map("profile_id")
  profile       PersonalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nom           String
  montantCible  Decimal         @db.Decimal(15, 2) @map("montant_cible")
  montantActuel Decimal         @db.Decimal(15, 2) @default(0) @map("montant_actuel")
  dateEcheance  DateTime?       @map("date_echeance")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([profileId])
  @@map("personal_objectifs")
}

// ─────────────────────────────────────────
// ENTREPRISE
// ─────────────────────────────────────────

model Company {
  id             String         @id @default(cuid())
  atheisNumber   String?        @unique @map("athenis_number")

  // Identité légale
  nom            String
  nomCommercial  String?        @map("nom_commercial")
  formeJuridique String?        @map("forme_juridique")
  siren          String?
  siret          String?
  rccm           String?
  niu            String?
  capital        Decimal?       @db.Decimal(15, 2)
  secteur        String?
  taille         CompanySize    @default(PME)
  logoUrl        String?        @map("logo_url")

  // Localisation
  adresse        String?
  ville          String?
  codePostal     String?        @map("code_postal")
  pays           String         @default("CM")
  telephone      String?
  email          String?
  siteWeb        String?        @map("site_web")

  // Configuration comptable & locale
  currency       String         @default("XAF")
  currencySymbol String         @default("F CFA") @map("currency_symbol")
  accountingZone AccountingZone @default(OHADA) @map("accounting_zone")
  accountingPlan String         @default("SYSCOHADA") @map("accounting_plan")
  locale         String         @default("fr-CM")
  timezone       String         @default("Africa/Douala")
  vatRate        Decimal        @db.Decimal(5, 4) @default(0.1925) @map("vat_rate")
  fiscalYearStart Int           @default(1) @map("fiscal_year_start")

  // Plan et abonnement
  plan           Plan           @default(FREE)
  planExpiresAt  DateTime?      @map("plan_expires_at")

  // Modules activés
  modules        String[]       @default(["gestion"])

  // Cabinet gestionnaire (optionnel)
  cabinetId      String?        @map("cabinet_id")
  cabinet        Cabinet?       @relation(fields: [cabinetId], references: [id])

  // Relations
  agences        Agence[]
  members        CompanyMember[]
  mandats        Mandat[]
  clients        Client[]
  invoices       Invoice[]
  expenses       Expense[]
  employees      Employee[]
  esgData        ESGData[]
  assets         Asset[]
  articles       Article[]
  stockFamilies  StockFamily[]
  fiscalYears    FiscalYear[]
  journalEntries JournalEntry[]
  accountPlans   AccountPlan[]
  accountReviews AccountReview[]
  taxDeclarations TaxDeclaration[]
  taxConfig      TaxConfig?
  contracts      Contract[]
  attachments    Attachment[]

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([cabinetId])
  @@map("companies")
}

enum CompanySize {
  TPE
  PME
  ETI
  GE
}

enum AccountingZone {
  FRANCE
  OHADA
  IFRS
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

// ─────────────────────────────────────────
// AGENCES
// ─────────────────────────────────────────

model Agence {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code      String
  nom       String
  adresse   String?
  ville     String?
  telephone String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  isSiege   Boolean  @default(false) @map("is_siege")

  members   AgenceMember[]
  invoices  Invoice[]
  expenses  Expense[]
  caisses   Caisse[]
  clients   Client[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("agences")
}

model Caisse {
  id        String   @id @default(cuid())
  agenceId  String   @map("agence_id")
  agence    Agence   @relation(fields: [agenceId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id")
  nom       String
  solde     Decimal  @db.Decimal(15, 2) @default(0)
  devise    String   @default("XAF")
  isActive  Boolean  @default(true) @map("is_active")

  mouvements CaisseMouvement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([agenceId])
  @@index([companyId])
  @@map("caisses")
}

model CaisseMouvement {
  id         String   @id @default(cuid())
  caisseId   String   @map("caisse_id")
  caisse     Caisse   @relation(fields: [caisseId], references: [id], onDelete: Cascade)
  type       String   // ENTREE | SORTIE
  montant    Decimal  @db.Decimal(15, 2)
  libelle    String
  reference  String?
  soldeApres Decimal  @db.Decimal(15, 2) @map("solde_apres")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([caisseId])
  @@map("caisse_mouvements")
}

// ─────────────────────────────────────────
// MEMBRES D'UNE ENTREPRISE
// ─────────────────────────────────────────

model CompanyMember {
  id          String       @id @default(cuid())
  userId      String       @unique @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String       @map("company_id")
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role        CompanyRole  @default(READONLY)

  // Permissions par module
  // Ex: { "gestion": "write", "accounting": "read", "hr": "none" }
  permissions Json         @default("{}")

  status      MemberStatus @default(ACTIVE)
  invitedBy   String?      @map("invited_by")
  invitedAt   DateTime?    @map("invited_at")
  joinedAt    DateTime?    @map("joined_at")

  // Agences rattachées (vide = accès à toutes)
  agences     AgenceMember[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("company_members")
}

model AgenceMember {
  id              String        @id @default(cuid())
  companyMemberId String        @map("company_member_id")
  companyMember   CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  agenceId        String        @map("agence_id")
  agence          Agence        @relation(fields: [agenceId], references: [id], onDelete: Cascade)

  // true → l'utilisateur ne voit QUE cette agence
  isRestricted    Boolean       @default(true) @map("is_restricted")

  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([companyMemberId, agenceId])
  @@index([agenceId])
  @@map("agence_members")
}

enum CompanyRole {
  OWNER       // Propriétaire (1 seul par company)
  ADMIN       // Administrateur complet
  MANAGER     // Gestionnaire
  ACCOUNTANT  // Comptable
  HR          // Responsable RH
  SALES       // Commercial
  READONLY    // Lecture seule
  CUSTOM      // Rôle personnalisé
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

model Invitation {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  email       String
  role        CompanyRole @default(READONLY)
  permissions Json        @default("{}")
  agenceIds   String[]    @map("agence_ids")
  token       String      @unique
  expiresAt   DateTime    @map("expires_at")
  acceptedAt  DateTime?   @map("accepted_at")
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([token])
  @@index([companyId])
  @@map("invitations")
}

// ─────────────────────────────────────────
// CABINET COMPTABLE
// ─────────────────────────────────────────

model Cabinet {
  id           String          @id @default(cuid())
  atheisNumber String?         @unique @map("athenis_number")

  nom          String
  siret        String?
  rccm         String?
  adresse      String?
  ville        String?
  pays         String          @default("CM")
  telephone    String?
  email        String?

  plan         Plan            @default(PREMIUM)

  members      CabinetMember[]
  companies    Company[]
  mandats      Mandat[]

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("cabinets")
}

model CabinetMember {
  id        String      @id @default(cuid())
  userId    String      @unique @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabinetId String      @map("cabinet_id")
  cabinet   Cabinet     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  role      CabinetRole @default(COLLABORATEUR)
  isActive  Boolean     @default(true) @map("is_active")

  createdAt DateTime    @default(now()) @map("created_at")

  @@index([cabinetId])
  @@map("cabinet_members")
}

enum CabinetRole {
  EXPERT_COMPTABLE
  COLLABORATEUR
  STAGIAIRE
}

model Mandat {
  id        String     @id @default(cuid())
  cabinetId String     @map("cabinet_id")
  cabinet   Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type      MandatType @default(COMPLET)
  modules   String[]   @default([])

  isActive  Boolean    @default(true) @map("is_active")
  dateDebut DateTime   @default(now()) @map("date_debut")
  dateFin   DateTime?  @map("date_fin")
  notes     String?

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([cabinetId, companyId])
  @@index([cabinetId])
  @@index([companyId])
  @@map("mandats")
}

enum MandatType {
  COMPLET
  COMPTABILITE
  GESTION
  FISCAL
  DECLARATIONS
  PARTIEL
}

// ─────────────────────────────────────────
// EXERCICES COMPTABLES
// ─────────────────────────────────────────

model FiscalYear {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  status         FiscalYearStatus @default(OPEN)
  closedBy       String?          @map("closed_by")
  closedAt       DateTime?        @map("closed_at")
  openingBalance Json?            @map("opening_balance")
  closingBalance Json?            @map("closing_balance")

  journalEntries  JournalEntry[]
  taxDeclarations TaxDeclaration[]
  accountReviews  AccountReview[]
  depreciations   AssetDepreciation[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([companyId, year])
  @@index([companyId, status])
  @@map("fiscal_years")
}

enum FiscalYearStatus {
  DRAFT
  OPEN
  LOCKED
  CLOSED
}

// ─────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────

model Client {
  id        String     @id @default(cuid())
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId  String?    @map("agence_id")
  agence    Agence?    @relation(fields: [agenceId], references: [id])

  nom       String
  type      ClientType @default(ENTREPRISE)
  email     String?
  telephone String?
  adresse   String?
  solde     Decimal    @db.Decimal(15, 2) @default(0)
  isActive  Boolean    @default(true) @map("is_active")

  invoices  Invoice[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([agenceId])
  @@map("clients")
}

enum ClientType {
  ENTREPRISE
  PARTICULIER
  FREELANCE
}

// ─────────────────────────────────────────
// FACTURES
// ─────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId    String?       @map("agence_id")
  agence      Agence?       @relation(fields: [agenceId], references: [id])
  clientId    String        @map("client_id")
  client      Client        @relation(fields: [clientId], references: [id])

  reference   String        @unique
  type        InvoiceType   @default(FACTURE)
  status      InvoiceStatus @default(PENDING)
  amountHT    Decimal       @db.Decimal(15, 2) @map("amount_ht")
  vatRate     Decimal       @db.Decimal(5, 4) @default(0.1925) @map("vat_rate")
  amountTTC   Decimal       @db.Decimal(15, 2) @map("amount_ttc")
  issuedAt    DateTime      @map("issued_at")
  dueAt       DateTime?     @map("due_at")
  paidAt      DateTime?     @map("paid_at")
  description String?

  createdBy   String        @map("created_by")
  attachments Attachment[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@index([agenceId])
  @@index([clientId])
  @@map("invoices")
}

enum InvoiceType {
  FACTURE
  DEVIS
  AVOIR
  FACTURE_RECURRENTE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ─────────────────────────────────────────
// DÉPENSES
// ─────────────────────────────────────────

model Expense {
  id        String          @id @default(cuid())
  companyId String          @map("company_id")
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId  String?         @map("agence_id")
  agence    Agence?         @relation(fields: [agenceId], references: [id])

  reference String          @unique
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(15, 2)
  date      DateTime
  note      String?
  createdBy String          @map("created_by")

  attachments Attachment[]

  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([companyId, date])
  @@index([agenceId])
  @@map("expenses")
}

enum ExpenseCategory {
  LOYER
  LOGICIELS
  TRANSPORT
  MARKETING
  FOURNITURES
  SALAIRES
  AUTRES
}

// ─────────────────────────────────────────
// RH — EMPLOYÉS
// ─────────────────────────────────────────

model Employee {
  id              String         @id @default(cuid())
  companyId       String         @map("company_id")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId        String?        @map("agence_id")

  nom             String
  prenom          String?
  poste           String
  contrat         ContractType
  salaireNet      Decimal        @db.Decimal(15, 2) @map("salaire_net")
  salaireBrut     Decimal?       @db.Decimal(15, 2) @map("salaire_brut")
  email           String?
  telephone       String?
  dateEmbauche    DateTime?      @map("date_embauche")
  dateFinContrat  DateTime?      @map("date_fin_contrat")
  status          EmployeeStatus @default(ACTIF)
  cnpsNumber      String?        @map("cnps_number")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([agenceId])
  @@map("employees")
}

enum ContractType {
  CDI
  CDD
  FREELANCE
  STAGE
  ALTERNANCE
}

enum EmployeeStatus {
  ACTIF
  INACTIF
  SUSPENDU
}

// ─────────────────────────────────────────
// COMPTABILITÉ — JOURNAL
// ─────────────────────────────────────────

model JournalEntry {
  id           String     @id @default(cuid())
  companyId    String     @map("company_id")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String     @map("fiscal_year_id")
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  date         DateTime
  journal      String
  compte       String
  libelle      String
  debit        Decimal    @db.Decimal(15, 2) @default(0)
  credit       Decimal    @db.Decimal(15, 2) @default(0)
  reference    String?
  lettrage     String?
  createdBy    String     @map("created_by")

  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([companyId, fiscalYearId])
  @@index([compte])
  @@map("journal_entries")
}

// ─────────────────────────────────────────
// COMPTABILITÉ — PLAN COMPTABLE
// ─────────────────────────────────────────

model AccountPlan {
  id        String         @id @default(cuid())
  companyId String         @map("company_id")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numero    String
  intitule  String
  classe    Int
  type      AccountPlanType
  zone      AccountingZone
  isSystem  Boolean        @default(true) @map("is_system")
  isActive  Boolean        @default(true) @map("is_active")

  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([companyId, numero])
  @@index([companyId, classe])
  @@map("account_plans")
}

enum AccountPlanType {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT
}

// ─────────────────────────────────────────
// COMPTABILITÉ — RÉVISION
// ─────────────────────────────────────────

model AccountReview {
  id            String       @id @default(cuid())
  companyId     String       @map("company_id")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId  String       @map("fiscal_year_id")
  fiscalYear    FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountNumber String       @map("account_number")
  cycle         Int
  status        ReviewStatus @default(PENDING)
  reviewedBy    String?      @map("reviewed_by")
  reviewedAt    DateTime?    @map("reviewed_at")
  note          String?
  isAnomaly     Boolean      @default(false) @map("is_anomaly")
  anomalyNote   String?      @map("anomaly_note")

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, fiscalYearId, accountNumber])
  @@index([companyId])
  @@map("account_reviews")
}

enum ReviewStatus {
  PENDING
  REVIEWED
  ANOMALY
}

// ─────────────────────────────────────────
// IMMOBILISATIONS
// ─────────────────────────────────────────

model Asset {
  id               String        @id @default(cuid())
  companyId        String        @map("company_id")
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  designation      String
  accountNumber    String        @map("account_number")
  category         AssetCategory
  status           AssetStatus   @default(IN_SERVICE)
  acquisitionDate  DateTime      @map("acquisition_date")
  grossValue       Decimal       @db.Decimal(15, 2) @map("gross_value")
  residualValue    Decimal       @db.Decimal(15, 2) @default(0) @map("residual_value")
  depreciationMode DeprecMode    @default(LINEAR) @map("depreciation_mode")
  usefulLifeYears  Int           @map("useful_life_years")
  depreciationRate Decimal       @db.Decimal(6, 4) @map("depreciation_rate")
  supplier         String?
  location         String?

  depreciations    AssetDepreciation[]

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("assets")
}

model AssetDepreciation {
  id              String     @id @default(cuid())
  assetId         String     @map("asset_id")
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalYearId    String     @map("fiscal_year_id")
  fiscalYear      FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  year            Int
  openingValue    Decimal    @db.Decimal(15, 2) @map("opening_value")
  depreciationAmt Decimal    @db.Decimal(15, 2) @map("depreciation_amt")
  closingValue    Decimal    @db.Decimal(15, 2) @map("closing_value")
  entryGenerated  Boolean    @default(false) @map("entry_generated")

  createdAt       DateTime   @default(now()) @map("created_at")

  @@unique([assetId, year])
  @@map("asset_depreciations")
}

enum AssetCategory {
  INCORPOREL
  CORPOREL
  FINANCIER
  EN_COURS
}

enum AssetStatus {
  IN_SERVICE
  DISPOSED
  SCRAPPED
  IN_PROGRESS
}

enum DeprecMode {
  LINEAR
  DEGRESSIVE
}

// ─────────────────────────────────────────
// STOCKS
// ─────────────────────────────────────────

model StockFamily {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  nom         String
  description String?
  articles    Article[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("stock_families")
}

model Article {
  id               String       @id @default(cuid())
  companyId        String       @map("company_id")
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  familleId        String?      @map("famille_id")
  famille          StockFamily? @relation(fields: [familleId], references: [id])

  reference        String
  designation      String
  unite            String       @default("unité")
  prixAchat        Decimal      @db.Decimal(15, 4) @map("prix_achat")
  prixVente        Decimal      @db.Decimal(15, 4) @map("prix_vente")
  stockActuel      Decimal      @db.Decimal(15, 4) @default(0) @map("stock_actuel")
  stockMin         Decimal      @db.Decimal(15, 4) @default(0) @map("stock_min")
  stockMax         Decimal?     @db.Decimal(15, 4) @map("stock_max")
  valeurCmup       Decimal      @db.Decimal(15, 4) @default(0) @map("valeur_cmup")
  methodeValuation StockMethod  @default(CMUP) @map("methode_valuation")
  isActive         Boolean      @default(true) @map("is_active")
  compteAchat      String?      @map("compte_achat")
  compteVente      String?      @map("compte_vente")

  mouvements       StockMouvement[]
  lotsFifo         StockLot[]

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([familleId])
  @@map("articles")
}

model StockMouvement {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  articleId    String   @map("article_id")
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  type         MouvType
  quantite     Decimal  @db.Decimal(15, 4)
  prixUnitaire Decimal  @db.Decimal(15, 4) @map("prix_unitaire")
  prixTotal    Decimal  @db.Decimal(15, 4) @map("prix_total")
  stockAvant   Decimal  @db.Decimal(15, 4) @map("stock_avant")
  stockApres   Decimal  @db.Decimal(15, 4) @map("stock_apres")
  cmupAvant    Decimal  @db.Decimal(15, 4) @map("cmup_avant")
  cmupApres    Decimal  @db.Decimal(15, 4) @map("cmup_apres")
  reference    String?
  description  String?
  createdBy    String   @map("created_by")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, articleId])
  @@index([createdAt])
  @@map("stock_mouvements")
}

model StockLot {
  id               String   @id @default(cuid())
  articleId        String   @map("article_id")
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  quantiteInitiale Decimal  @db.Decimal(15, 4) @map("quantite_initiale")
  quantiteRestante Decimal  @db.Decimal(15, 4) @map("quantite_restante")
  prixUnitaire     Decimal  @db.Decimal(15, 4) @map("prix_unitaire")
  dateEntree       DateTime @map("date_entree")
  reference        String?
  isEpuise         Boolean  @default(false) @map("is_epuise")

  createdAt        DateTime @default(now()) @map("created_at")

  @@index([articleId, isEpuise])
  @@map("stock_lots")
}

enum StockMethod {
  CMUP
  FIFO
}

enum MouvType {
  ENTREE_ACHAT
  ENTREE_RETOUR
  ENTREE_INVENTAIRE
  SORTIE_VENTE
  SORTIE_CASSE
  SORTIE_INVENTAIRE
  AJUSTEMENT
}

// ─────────────────────────────────────────
// ESG
// ─────────────────────────────────────────

model ESGData {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  pillar      ESGPillar
  indicatorId String    @map("indicator_id")
  value       Decimal   @db.Decimal(15, 4)
  target      Decimal   @db.Decimal(15, 4)
  unit        String
  year        Int

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, indicatorId, year])
  @@index([companyId, year])
  @@map("esg_data")
}

enum ESGPillar {
  E
  S
  G
}

// ─────────────────────────────────────────
// JURIDIQUE
// ─────────────────────────────────────────

model Contract {
  id            String          @id @default(cuid())
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reference     String          @unique
  titre         String
  type          ContractDocType
  status        ContractStatus  @default(DRAFT)
  parties       String[]
  dateSignature DateTime?       @map("date_signature")
  dateDebut     DateTime?       @map("date_debut")
  dateFin       DateTime?       @map("date_fin")
  montant       Decimal?        @db.Decimal(15, 2)
  notes         String?
  createdBy     String          @map("created_by")

  attachments   Attachment[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("contracts")
}

enum ContractDocType {
  PRESTATION
  CDI
  CDD
  BAIL
  NDA
  CGV
  CGU
  STATUTS
  AUTRE
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────
// FISCALITÉ
// ─────────────────────────────────────────

model TaxConfig {
  id                 String    @id @default(cuid())
  companyId          String    @unique @map("company_id")
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  country            String    @default("CM")
  taxRegime          TaxRegime @default(REEL_NORMAL) @map("tax_regime")
  vatRegime          VatRegime @default(MENSUEL) @map("vat_regime")
  isFirstYear        Boolean   @default(true) @map("is_first_year")
  centerImpots       String?   @map("center_impots")
  niu                String?
  rccm               String?
  professionLiberale Boolean   @default(false) @map("profession_liberale")
  cnpsRate           Decimal   @db.Decimal(6, 4) @default(0.162) @map("cnps_rate")
  igsClass           Int?      @map("igs_class")
  igsAmount          Decimal?  @db.Decimal(15, 2) @map("igs_amount")
  regimeHistory      Json?     @map("regime_history")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("tax_configs")
}

model TaxDeclaration {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId  String?       @map("fiscal_year_id")
  fiscalYear    FiscalYear?   @relation(fields: [fiscalYearId], references: [id])

  type          TaxType
  period        String
  year          Int
  month         Int?
  baseAmount    Decimal       @db.Decimal(15, 2) @map("base_amount")
  taxAmount     Decimal       @db.Decimal(15, 2) @map("tax_amount")
  status        TaxDeclStatus @default(PENDING)
  dueDate       DateTime      @map("due_date")
  declaredAt    DateTime?     @map("declared_at")
  paidAt        DateTime?     @map("paid_at")
  penaltyAmount Decimal       @db.Decimal(15, 2) @default(0) @map("penalty_amount")
  reference     String?

  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([companyId, type, year])
  @@map("tax_declarations")
}

enum TaxRegime {
  IGS
  REEL_NORMAL
  REEL_SIMPLIFIE
}

enum VatRegime {
  MENSUEL
  TRIMESTRIEL
  NON_ASSUJETTI
}

enum TaxType {
  TVA
  IS
  IS_ACOMPTE
  PATENTE
  RAS
  CNPS
  FDFP
  DSF
  IGS
}

enum TaxDeclStatus {
  PENDING
  DECLARED
  PAID
  LATE
  EXEMPTED
}

// ─────────────────────────────────────────
// PIÈCES JUSTIFICATIVES
// ─────────────────────────────────────────

model Attachment {
  id         String    @id @default(cuid())
  companyId  String    @map("company_id")
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fileName   String    @map("file_name")
  fileSize   Int       @map("file_size")
  mimeType   String    @map("mime_type")
  storageKey String    @unique @map("storage_key")
  uploadedBy String    @map("uploaded_by")

  invoiceId  String?   @map("invoice_id")
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expenseId  String?   @map("expense_id")
  expense    Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  contractId String?   @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  uploadedAt DateTime  @default(now()) @map("uploaded_at")

  @@index([companyId])
  @@index([invoiceId])
  @@index([expenseId])
  @@map("attachments")
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId  String?  @map("company_id")
  agenceId   String?  @map("agence_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  success    Boolean  @default(true)

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// BARÈME IGS
// ─────────────────────────────────────────

model IgsBareme {
  id          String  @id @default(cuid())
  classe      Int     @unique
  caMin       Decimal @db.Decimal(15, 2) @map("ca_min")
  caMax       Decimal @db.Decimal(15, 2) @map("ca_max")
  montantBase Decimal @db.Decimal(15, 2) @map("montant_base")
  montantCga  Decimal @db.Decimal(15, 2) @map("montant_cga")
  year        Int     @default(2026)

  @@map("igs_baremes")
}
