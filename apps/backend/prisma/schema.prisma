generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// UTILISATEURS
// ─────────────────────────────────────────

model User {
  id           String      @id @default(cuid())
  atheisNumber String?     @unique @map("athenis_number")

  // Identité
  nom          String      @map("first_name")
  prenom       String?     @map("last_name")
  email        String      @unique

  passwordHash String      @map("password_hash")

  // Auth
  twoFASecret    String?   @map("totp_secret")
  twoFAEnabled   Boolean   @default(false) @map("totp_enabled")
  failedAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  isActive       Boolean   @default(true) @map("is_active")

  // Type de compte
  accountType  AccountType @map("account_type")

  // Rôle global (colonne DB: role)
  role         Role        @default(READONLY)

  // Lien direct company/cabinet (colonnes dans users)
  companyId    String?     @map("company_id")
  cabinetId    String?     @map("cabinet_id")

  // Relations
  companyMemberships CompanyMember[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  cabinet            Cabinet?       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  company            Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([accountType])
  @@map("users")
}

enum AccountType {
  PERSONAL
  COMPANY
  CABINET
}

enum Role {
  ADMIN
  COMPTABLE
  READONLY
  RH
  JURIDIQUE
}

model RefreshToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique @map("token_hash")
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByHash  String?   @map("replaced_by_hash")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// COMPTEUR NUMÉROS ATHENIS
// ─────────────────────────────────────────

model AtheisCounter {
  id         String      @id @default(cuid())
  type       AccountType @unique
  lastNumber Int         @default(0) @map("last_number")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("athenis_counters")
}

// ─────────────────────────────────────────
// ENTREPRISE
// ─────────────────────────────────────────

model Company {
  id             String         @id @default(cuid())

  // Identité légale
  nom            String         @map("name")
  formeJuridique String?        @map("legal_form")
  siren          String?        @unique
  siret          String?
  capital        Decimal?       @db.Decimal(18, 2)
  secteur        String?
  taille         CompanySize    @default(PME)
  logoUrl        String?        @map("logo")

  // Localisation
  adresse        String?        @map("address")
  ville          String?        @map("city")
  codePostal     String?        @map("postal_code")
  pays           String         @default("FR") @map("country")
  telephone      String?        @map("phone")
  email          String?        @map("contact_email")
  siteWeb        String?        @map("website")

  // Configuration comptable & locale
  currency       String         @default("EUR")
  currencySymbol String         @default("€") @map("currency_symbol")
  accountingZone AccountingZone @default(FRANCE) @map("accounting_zone")
  accountingPlan        String         @default("PCG") @map("accounting_plan")
  accountNumberLength   Int            @default(4) @map("account_number_length")
  locale                String         @default("fr-FR")
  timezone              String         @default("Europe/Paris")
  fiscalYearStart       Int?           @map("fiscal_year_start")

  // Plan et abonnement
  plan           Plan           @default(FREE)
  planExpiresAt  DateTime?      @map("plan_expires_at")

  // Modules activés
  modules        String[]       @default([])

  // Cabinet gestionnaire (optionnel)
  cabinetId      String?        @map("cabinet_id")
  cabinet        Cabinet?       @relation(fields: [cabinetId], references: [id])

  // Relations
  members          CompanyMember[]
  mandats          Mandat[]
  clients          Client[]
  invoices         Invoice[]
  expenses         Expense[]
  employees        Employee[]
  esgData          ESGData[]
  assets           Asset[]
  articles         Article[]
  stockFamilies    StockFamily[]
  fiscalYears      FiscalYear[]
  journalEntries   JournalEntry[]
  accountPlans     AccountPlan[]
  accountReviews   AccountReview[]
  taxDeclarations  TaxDeclaration[]
  taxConfig        TaxConfig?
  attachments      Attachment[]
  users            User[]
  invitations      Invitation[]
  companyRoles     CompanyRole[]
  aiConversations  AiConversation[]
  annualReviews    AnnualReview[]
  bankTransactions BankTransaction[]
  esgActions       EsgAction[]
  fiscalYearCloses FiscalYearClose[]
  gdprEntries      GdprEntry[]
  leaveRequests    LeaveRequest[]
  legalAlerts      LegalAlert[]
  legalContracts   LegalContract[]
  quotes           Quote[]
  recurringInvoices RecurringInvoice[]
  vatDeclarations  VatDeclaration[]
  workSchedules    WorkSchedule[]

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([cabinetId])
  @@map("companies")
}

enum CompanySize {
  TPE
  PME
  ETI
  GE
}

enum AccountingZone {
  FRANCE
  OHADA
  IFRS
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

// ─────────────────────────────────────────
// MEMBRES D'UNE ENTREPRISE
// ─────────────────────────────────────────

model CompanyMember {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String     @map("role_id")
  role      CompanyRole @relation(fields: [roleId], references: [id])
  status    UserStatus @default(ACTIVE)
  invitedBy String?    @map("invited_by")
  invitedAt DateTime?  @map("invited_at")
  joinedAt  DateTime?  @map("joined_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([companyId, userId])
  @@index([companyId])
  @@map("company_users")
}

model Invitation {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  roleId      String    @map("role_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([companyId])
  @@map("invitations")
}

// ─────────────────────────────────────────
// CABINET COMPTABLE
// ─────────────────────────────────────────

model Cabinet {
  id        String    @id @default(cuid())

  nom       String    @map("name")
  siret     String?   @unique

  companies Company[]
  mandats   Mandat[]
  users     User[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("cabinets")
}

model Mandat {
  id        String     @id @default(cuid())
  cabinetId String     @map("cabinet_id")
  cabinet   Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type      MandatType @default(COMPLET)
  modules   String[]   @default([])

  actif     Boolean    @default(true)

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([cabinetId, companyId])
  @@index([cabinetId])
  @@index([companyId])
  @@map("mandats")
}

enum MandatType {
  COMPLET
  COMPTABILITE
  GESTION
  DECLARATIONS
}

// ─────────────────────────────────────────
// EXERCICES COMPTABLES
// ─────────────────────────────────────────

model FiscalYear {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  status         FiscalYearStatus @default(OPEN)
  closedBy       String?          @map("closed_by")
  closedAt       DateTime?        @map("closed_at")
  createdBy      String           @map("created_by")
  openingBalance Json?            @map("opening_balance")
  closingBalance Json?            @map("closing_balance")

  journalEntries  JournalEntry[]
  taxDeclarations TaxDeclaration[]
  accountReviews  AccountReview[]
  depreciations   AssetDepreciation[]
  invoices        Invoice[]
  expenses        Expense[]
  vatDeclarations VatDeclaration[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([companyId, year])
  @@index([companyId, status])
  @@map("fiscal_years")
}

enum FiscalYearStatus {
  DRAFT
  OPEN
  LOCKED
  CLOSED
}

// ─────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────

model Client {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nom       String  @map("name")
  email     String?
  telephone String? @map("phone")
  adresse   String? @map("address")
  siren     String?
  isActive  Boolean @default(true) @map("is_active")

  invoices          Invoice[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("clients")
}

// ─────────────────────────────────────────
// FACTURES
// ─────────────────────────────────────────

model Invoice {
  id           String        @id @default(cuid())
  companyId    String        @map("company_id")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId     String        @map("client_id")
  client       Client        @relation(fields: [clientId], references: [id])
  fiscalYearId String?       @map("fiscal_year_id")
  fiscalYear   FiscalYear?   @relation(fields: [fiscalYearId], references: [id])

  reference    String        @map("number")
  status       InvoiceStatus @default(DRAFT)
  amountHT     Decimal       @db.Decimal(12, 2) @map("subtotal")
  vatRate      Decimal       @db.Decimal(5, 2) @default(20) @map("tax_rate")
  amountTTC    Decimal       @db.Decimal(12, 2) @map("total")
  taxAmount    Decimal       @db.Decimal(12, 2) @map("tax_amount")
  issuedAt     DateTime      @map("issue_date")
  dueAt        DateTime      @map("due_date")
  paidAt       DateTime?     @map("paid_at")
  description  String?       @map("notes")

  quoteId            String?          @unique @map("quote_id")
  recurringInvoiceId String?          @map("recurring_invoice_id")
  attachments        Attachment[]
  bankTransactions   BankTransaction[]
  quote              Quote?           @relation(fields: [quoteId], references: [id])
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([clientId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ─────────────────────────────────────────
// DÉPENSES
// ─────────────────────────────────────────

model Expense {
  id           String          @id @default(cuid())
  companyId    String          @map("company_id")
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String?         @map("fiscal_year_id")
  fiscalYear   FiscalYear?     @relation(fields: [fiscalYearId], references: [id])

  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  date         DateTime
  receiptUrl   String?         @map("receipt_url")

  attachments      Attachment[]
  bankTransactions BankTransaction[]

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([companyId, date])
  @@map("expenses")
}

enum ExpenseCategory {
  TRAVEL
  EQUIPMENT
  SOFTWARE
  SALARY
  RENT
  MARKETING
  CONSULTING
  OTHER
}

// ─────────────────────────────────────────
// RH — EMPLOYÉS
// ─────────────────────────────────────────

model Employee {
  id             String         @id @default(cuid())
  companyId      String         @map("company_id")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nom            String         @map("last_name")
  prenom         String         @map("first_name")
  email          String
  contrat        EmploymentType @map("employment_type")
  salaireBrut    Decimal        @db.Decimal(12, 2) @map("gross_salary")
  dateEmbauche   DateTime       @map("start_date")
  dateFinContrat DateTime?      @map("end_date")

  annualReviews AnnualReview[]
  leaveRequests LeaveRequest[]
  workSchedules WorkSchedule[]

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

// ─────────────────────────────────────────
// COMPTABILITÉ — JOURNAL
// ─────────────────────────────────────────

model JournalEntry {
  id           String     @id @default(cuid())
  companyId    String     @map("company_id")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String     @map("fiscal_year_id")
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  date         DateTime
  journal      String     @map("journal_code")
  pieceId      String?    @map("piece_id")
  compte       String     @map("account")
  libelle      String     @map("label")
  debit        Decimal    @db.Decimal(12, 2) @default(0)
  credit       Decimal    @db.Decimal(12, 2) @default(0)
  reference    String?
  lettrage     String?
  invoiceId    String?    @map("invoice_id")
  expenseId    String?    @map("expense_id")
  createdBy    String?    @map("created_by")

  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([companyId, fiscalYearId])
  @@index([compte])
  @@index([pieceId])
  @@map("journal_entries")
}

// ─────────────────────────────────────────
// COMPTABILITÉ — PLAN COMPTABLE
// ─────────────────────────────────────────

model AccountPlan {
  id        String          @id @default(cuid())
  companyId String          @map("company_id")
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numero    String
  intitule  String
  classe    Int
  type      AccountPlanType
  zone      AccountingZone
  isSystem  Boolean         @default(true) @map("is_system")
  isActive  Boolean         @default(true) @map("is_active")

  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([companyId, numero])
  @@index([companyId, classe])
  @@map("account_plans")
}

enum AccountPlanType {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT

  @@map("ChartAccountType")
}

// ─────────────────────────────────────────
// COMPTABILITÉ — RÉVISION
// ─────────────────────────────────────────

model AccountReview {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId    String?      @map("fiscal_year_id")
  fiscalYear      FiscalYear?  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  year            Int
  accountNumber   String       @map("account_number")
  cycle           Int
  status          ReviewStatus @default(PENDING)
  reviewedBy      String?      @map("reviewed_by")
  reviewedAt      DateTime?    @map("reviewed_at")
  note            String?
  isAnomaly       Boolean      @default(false) @map("is_anomaly")
  anomalyNote     String?      @map("anomaly_note")
  anomalyResolvedAt DateTime?  @map("anomaly_resolved_at")
  resolutionNote  String?      @map("resolution_note")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, fiscalYearId, accountNumber])
  @@index([companyId])
  @@map("account_reviews")
}

enum ReviewStatus {
  PENDING
  REVIEWED
  ANOMALY

  @@map("AccountReviewStatus")
}

// ─────────────────────────────────────────
// IMMOBILISATIONS
// ─────────────────────────────────────────

model Asset {
  id               String        @id @default(cuid())
  companyId        String        @map("company_id")
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId     String?       @map("fiscal_year_id")

  designation      String
  accountNumber    String        @map("account_number")
  category         AssetCategory
  status           AssetStatus   @default(IN_SERVICE)
  acquisitionDate  DateTime      @map("acquisition_date")
  serviceDate      DateTime?     @map("service_date")
  disposalDate     DateTime?     @map("disposal_date")
  grossValue       Decimal       @db.Decimal(15, 2) @map("gross_value")
  residualValue    Decimal       @db.Decimal(15, 2) @default(0) @map("residual_value")
  depreciationMode DeprecMode    @default(LINEAR) @map("depreciation_mode")
  usefulLifeYears  Int           @map("useful_life_years")
  depreciationRate Decimal       @db.Decimal(6, 4) @map("depreciation_rate")
  supplier         String?
  serialNumber     String?       @map("serial_number")
  location         String?
  notes            String?

  depreciations    AssetDepreciation[]

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("assets")
}

model AssetDepreciation {
  id              String     @id @default(cuid())
  assetId         String     @map("asset_id")
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalYearId    String     @map("fiscal_year_id")
  fiscalYear      FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  year            Int
  openingValue    Decimal    @db.Decimal(15, 2) @map("opening_value")
  depreciationAmt Decimal    @db.Decimal(15, 2) @map("depreciation_amt")
  closingValue    Decimal    @db.Decimal(15, 2) @map("closing_value")
  entryGenerated  Boolean    @default(false) @map("entry_generated")

  createdAt       DateTime   @default(now()) @map("created_at")

  @@unique([assetId, year])
  @@map("asset_depreciations")
}

enum AssetCategory {
  INCORPOREL
  CORPOREL
  FINANCIER
  EN_COURS
}

enum AssetStatus {
  IN_SERVICE
  DISPOSED
  SCRAPPED
  IN_PROGRESS
}

enum DeprecMode {
  LINEAR
  DEGRESSIVE
}

// ─────────────────────────────────────────
// STOCKS
// ─────────────────────────────────────────

model StockFamily {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  nom         String
  description String?
  articles    Article[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("stock_families")
}

model Article {
  id               String       @id @default(cuid())
  companyId        String       @map("company_id")
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  familleId        String?      @map("famille_id")
  famille          StockFamily? @relation(fields: [familleId], references: [id])

  reference        String
  designation      String
  unite            String       @default("unité")
  prixAchat        Decimal      @db.Decimal(15, 4) @map("prix_achat")
  prixVente        Decimal      @db.Decimal(15, 4) @map("prix_vente")
  stockActuel      Decimal      @db.Decimal(15, 4) @default(0) @map("stock_actuel")
  stockMin         Decimal      @db.Decimal(15, 4) @default(0) @map("stock_min")
  stockMax         Decimal?     @db.Decimal(15, 4) @map("stock_max")
  valeurCmup       Decimal      @db.Decimal(15, 4) @default(0) @map("valeur_cmup")
  methodeValuation StockMethod  @default(CMUP) @map("methode_valuation")
  isActive         Boolean      @default(true) @map("is_active")
  compteAchat      String?      @map("compte_achat")
  compteVente      String?      @map("compte_vente")

  mouvements       StockMouvement[]
  lotsFifo         StockLot[]

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([familleId])
  @@map("articles")
}

model StockMouvement {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  articleId    String   @map("article_id")
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  type         MouvType
  quantite     Decimal  @db.Decimal(15, 4)
  prixUnitaire Decimal  @db.Decimal(15, 4) @map("prix_unitaire")
  prixTotal    Decimal  @db.Decimal(15, 4) @map("prix_total")
  stockAvant   Decimal  @db.Decimal(15, 4) @map("stock_avant")
  stockApres   Decimal  @db.Decimal(15, 4) @map("stock_apres")
  cmupAvant    Decimal  @db.Decimal(15, 4) @map("cmup_avant")
  cmupApres    Decimal  @db.Decimal(15, 4) @map("cmup_apres")
  reference    String?
  description  String?
  createdBy    String   @map("created_by")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, articleId])
  @@index([createdAt])
  @@map("stock_mouvements")
}

model StockLot {
  id               String   @id @default(cuid())
  articleId        String   @map("article_id")
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  quantiteInitiale Decimal  @db.Decimal(15, 4) @map("quantite_initiale")
  quantiteRestante Decimal  @db.Decimal(15, 4) @map("quantite_restante")
  prixUnitaire     Decimal  @db.Decimal(15, 4) @map("prix_unitaire")
  dateEntree       DateTime @map("date_entree")
  reference        String?
  isEpuise         Boolean  @default(false) @map("is_epuise")

  createdAt        DateTime @default(now()) @map("created_at")

  @@index([articleId, isEpuise])
  @@map("stock_lots")
}

enum StockMethod {
  CMUP
  FIFO
}

enum MouvType {
  ENTREE_ACHAT
  ENTREE_RETOUR
  ENTREE_INVENTAIRE
  SORTIE_VENTE
  SORTIE_CASSE
  SORTIE_INVENTAIRE
  TRANSFERT
  AJUSTEMENT
}

// ─────────────────────────────────────────
// ESG
// ─────────────────────────────────────────

model ESGData {
  id          String  @id @default(cuid())
  companyId   String  @map("company_id")
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year        Int
  energyKwh   Decimal? @db.Decimal(12, 2) @map("energy_kwh")
