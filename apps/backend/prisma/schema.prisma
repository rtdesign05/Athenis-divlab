  rejectedAt   DateTime?               @map("rejected_at")
  createdBy    String                  @map("created_by")
  createdAt    DateTime                @default(now()) @map("created_at")

  @@index([cabinetId])
  @@index([token])
  @@map("cabinet_invitations")
}

enum CabinetInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

