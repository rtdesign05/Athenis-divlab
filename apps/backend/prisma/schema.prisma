  REEL_SIMPLIFIE
  FORFAIT_BIENNAL
  MICRO_ENTREPRISE
  LIBERATOIRE
}

enum VatRegime {
  MENSUEL
  TRIMESTRIEL
  NON_ASSUJETTI
}

enum TaxType {
  TVA
  IS
  IS_ACOMPTE
  PATENTE
  RAS
  CNPS
  FDFP
  DSF
}

enum TaxDeclStatus {
  PENDING
  DECLARED
  PAID
  LATE
  EXEMPTED
}

