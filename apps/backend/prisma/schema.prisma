// ─────────────────────────────────────────

model LegalContract {
  id           String               @id @default(cuid())
  companyId    String               @map("company_id")
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  type         ContractType
  status       ContractStatus       @default(DRAFT)
  parties      Json
  content      String?
  fileUrl      String?              @map("file_url")
  signedAt     DateTime?            @map("signed_at")
  expiresAt    DateTime?            @map("expires_at")
  terminatedAt DateTime?            @map("terminated_at")
  notes        String?
  signatures   ContractSignature[]
  legalAlerts  LegalAlert[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("legal_contracts")
}

model ContractSignature {
  id           String          @id @default(cuid())
  contractId   String          @map("contract_id")
  contract     LegalContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerName   String          @map("signer_name")
  signerEmail  String          @map("signer_email")
  signerRole   String?         @map("signer_role")
  status       SignatureStatus @default(PENDING)
  token        String          @unique
  signedAt     DateTime?       @map("signed_at")
  refusedAt    DateTime?       @map("refused_at")
  refusedNote  String?         @map("refused_note")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([contractId])
  @@index([token])
  @@map("contract_signatures")
}

model LegalAlert {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId  String?        @map("contract_id")
  contract    LegalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  message     String
  severity    AlertSeverity  @default(INFO)
  status      AlertStatus    @default(OPEN)
  dueDate     DateTime?      @map("due_date")
  dismissedAt DateTime?      @map("dismissed_at")
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([severity])
  @@index([status])
  @@map("legal_alerts")
}

