generator client {
  provider      = "prisma-client-js"
  // binaryTargets : "native" pour dev (Windows/macOS/Linux glibc),
  // "linux-musl-openssl-3.0.x" pour les images Docker Alpine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// UTILISATEURS
// ─────────────────────────────────────────

model User {
  id           String      @id @default(cuid())
  atheisNumber String?     @unique @map("athenis_number")

  // Identité
  nom          String      @map("first_name")
  prenom       String?     @map("last_name")
  email        String      @unique

  passwordHash String      @map("password_hash")

  // Auth
  twoFASecret    String?   @map("totp_secret")
  twoFAEnabled   Boolean   @default(false) @map("totp_enabled")
  failedAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  isActive       Boolean   @default(true) @map("is_active")

  // Multi-factor authentication
  // NONE     = pas de 2FA
  // TOTP     = application (Google Authenticator, Authy…) — utilise twoFASecret
  // EMAIL    = code envoyé par e-mail à chaque connexion
  // SMS      = code envoyé par SMS au numéro mfaPhone
  mfaMethod        MfaMethod @default(NONE) @map("mfa_method")
  mfaPhone         String?                  @map("mfa_phone")           // format E.164 (ex: +237691234567)
  mfaPhoneVerified Boolean   @default(false) @map("mfa_phone_verified")
  // Code temporaire (one-time) pour EMAIL/SMS — hashé en SHA-256
  mfaActiveCodeHash   String?   @map("mfa_active_code_hash")
  mfaCodeExpiresAt    DateTime? @map("mfa_code_expires_at")
  mfaCodeAttempts     Int       @default(0) @map("mfa_code_attempts")

  // Vérification email
  emailVerified              Boolean   @default(false) @map("email_verified")
  emailVerificationToken     String?   @unique         @map("email_verification_token")
  emailVerificationExpiresAt DateTime?                 @map("email_verification_expires_at")

  // Validation admin (workflow phase de test : chaque signup doit être approuvé par SUPER_ADMIN)
  approvalStatus   ApprovalStatus @default(PENDING_APPROVAL) @map("approval_status")
  approvedAt       DateTime?                                  @map("approved_at")
  approvedById     String?                                    @map("approved_by_id")
  rejectedAt       DateTime?                                  @map("rejected_at")
  rejectionReason  String?                                    @map("rejection_reason")

  // Type de compte
  accountType  AccountType  @map("account_type")

  // Rôle global (colonne DB: role)
  role         Role         @default(READONLY)

  // Rôle plateforme — seul SUPER_ADMIN accède aux métriques SaaS globales
  platformRole PlatformRole @default(USER) @map("platform_role")

  // Lien direct company/cabinet (colonnes dans users)
  companyId    String?     @map("company_id")
  cabinetId    String?     @map("cabinet_id")

  // Relations
  companyMemberships CompanyMember[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  cabinet            Cabinet?         @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  personalProfile    PersonalProfile?
  personalRevenus    PersonalRevenue[]
  personalDepenses   PersonalExpense[]
  personalObjectifs  PersonalObjectif[]
  personalComptes    PersonalCompte[]

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([accountType])
  @@map("users")
}

enum AccountType {
  PERSONAL
  COMPANY
  CABINET
}

enum Role {
  ADMIN
  COMPTABLE
  READONLY
  RH
  JURIDIQUE
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum MfaMethod {
  NONE
  TOTP
  EMAIL
  SMS
}

// ─────────────────────────────────────────
// SaaS BILLING (Stripe + CinetPay/Mobile Money)
// ─────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING          // période d'essai en cours
  ACTIVE            // abonnement actif et payé
  PAST_DUE          // échec paiement, période de grâce
  CANCELED          // annulé par l'utilisateur (encore actif jusqu'à fin de période)
  EXPIRED           // période terminée, retour à FREE
  INCOMPLETE        // session de paiement créée mais pas complétée
}

enum PaymentProvider {
  STRIPE
  CINETPAY
  FREE              // pas de paiement (plan gratuit)
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id            String   @id @default(cuid())
  companyId     String   @unique  @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan          Plan     // FREE | STARTER | PRO | PREMIUM
  status        SubscriptionStatus @default(TRIALING)
  interval      BillingInterval    @default(MONTHLY)

  // Stripe
  stripeCustomerId       String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?  @unique @map("stripe_subscription_id")
  stripePriceId          String?         @map("stripe_price_id")

  // CinetPay (Mobile Money) — pas de subscription native, on track manuellement
  cinetpayLastTransactionId String?       @map("cinetpay_last_transaction_id")

  // Périodes
  currentPeriodStart  DateTime?  @map("current_period_start")
  currentPeriodEnd    DateTime?  @map("current_period_end")
  trialEnd            DateTime?  @map("trial_end")
  cancelAt            DateTime?  @map("cancel_at")
  canceledAt          DateTime?  @map("canceled_at")

  // Montant en centimes (ou unité minimale selon devise — FCFA n'a pas de centimes)
  amountCents   Int      @map("amount_cents")
  currency      String           // EUR, XAF, XOF, USD…
  provider      PaymentProvider  @default(FREE)

  payments      Payment[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id              String   @id @default(cuid())
  subscriptionId  String?  @map("subscription_id")
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider        PaymentProvider
  providerPaymentId String?  @unique  @map("provider_payment_id")  // Stripe payment_intent_id ou CinetPay transaction_id
  providerInvoiceId String?           @map("provider_invoice_id")  // Stripe invoice id

  status          PaymentStatus  @default(PENDING)
  amountCents     Int            @map("amount_cents")
  currency        String

  description     String?
  failureReason   String?  @map("failure_reason")

  paidAt          DateTime? @map("paid_at")

  // Mobile Money info (CinetPay)
  mobileMoneyOperator  String? @map("mobile_money_operator")  // ORANGE_CM, MTN_CM, etc.
  mobileMoneyPhone     String? @map("mobile_money_phone")

  // Carte (Stripe)
  cardLast4       String? @map("card_last4")
  cardBrand       String? @map("card_brand")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

model RefreshToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique @map("token_hash")
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByHash  String?   @map("replaced_by_hash")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// COMPTEUR NUMÉROS ATHENIS
// ─────────────────────────────────────────

model AtheisCounter {
  id         String      @id @default(cuid())
  type       AccountType @unique
  lastNumber Int         @default(0) @map("last_number")

  @@map("athenis_counters")
}

// ─────────────────────────────────────────
// ENTREPRISE
// ─────────────────────────────────────────

model Company {
  id             String         @id @default(cuid())

  // Identité légale
  nom            String         @map("name")
  formeJuridique String?        @map("legal_form")
  siren          String?        @unique
  siret          String?
  naf            String?        @map("naf_code")
  vatNumber      String?        @map("vat_number")
  capital        Decimal?       @db.Decimal(18, 2)
  secteur        String?
  taille         CompanySize    @default(PME)
  logoUrl        String?        @map("logo")

  // Personnalisation de la facturation
  primaryColor      String?        @map("primary_color")
  secondaryColor    String?        @map("secondary_color")
  font              String?
  invoiceMentions   String?        @map("invoice_mentions")
  paymentTerms      Int?           @map("payment_terms")
  lateInterestRate  Decimal?       @db.Decimal(5, 2) @map("late_interest_rate")
  discountRate      Decimal?       @db.Decimal(5, 2) @map("discount_rate")

  // Localisation
  adresse        String?        @map("address")
  ville          String?        @map("city")
  codePostal     String?        @map("postal_code")
  pays           String         @default("FR") @map("country")
  telephone      String?        @map("phone")
  email          String?        @map("contact_email")
  siteWeb        String?        @map("website")

  // Configuration comptable & locale
  currency       String         @default("EUR")
  currencySymbol String         @default("€") @map("currency_symbol")
  accountingZone AccountingZone @default(FRANCE) @map("accounting_zone")
  accountingPlan        String         @default("PCG") @map("accounting_plan")
  accountNumberLength   Int            @default(4) @map("account_number_length")
  locale                String         @default("fr-FR")
  timezone              String         @default("Europe/Paris")
  fiscalYearStart       Int?           @map("fiscal_year_start")

  // Plan et abonnement
  plan           Plan           @default(FREE)
  planExpiresAt  DateTime?      @map("plan_expires_at")

  // Modules activés
  modules        String[]       @default([])

  // Cabinet gestionnaire (optionnel)
  cabinetId      String?        @map("cabinet_id")
  cabinet        Cabinet?       @relation(fields: [cabinetId], references: [id])

  // Relations
  members          CompanyMember[]
  mandats          Mandat[]
  clients          Client[]
  invoices         Invoice[]
  expenses         Expense[]
  purchaseOrders   PurchaseOrder[]
  treasuryEntries  TreasuryEntry[]
  treasurySources  TreasurySource[]
  employees             Employee[]
  employmentContracts   EmploymentContract[]
  esgData               ESGData[]
  assets           Asset[]
  articles         Article[]
  stockFamilies    StockFamily[]
  fiscalYears      FiscalYear[]
  journalEntries   JournalEntry[]
  accountPlans     AccountPlan[]
  accountReviews   AccountReview[]
  taxDeclarations  TaxDeclaration[]
  taxConfig        TaxConfig?
  attachments      Attachment[]
  users            User[]
  invitations      Invitation[]
  companyRoles     CompanyRole[]
  aiConversations  AiConversation[]
  annualReviews    AnnualReview[]
  bankTransactions BankTransaction[]
  esgActions       EsgAction[]
  fiscalYearCloses FiscalYearClose[]
  gdprEntries      GdprEntry[]
  leaveRequests    LeaveRequest[]
  legalAlerts      LegalAlert[]
  legalContracts   LegalContract[]
  quotes           Quote[]
  recurringInvoices RecurringInvoice[]
  vatDeclarations  VatDeclaration[]
  workSchedules    WorkSchedule[]
  agences          Agence[]
  loans            Loan[]
  payrolls         Payroll[]

  // Security policy (JSON blob, per-company)
  securityPolicy Json? @map("security_policy")
  // Paramètres écritures de paie (compte 641, 431, 447, 521 par défaut + journal PAY)
  payrollConfig  Json? @map("payroll_config")

  // Billing SaaS (Stripe + CinetPay)
  subscription   Subscription?
  payments       Payment[]

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([cabinetId])
  @@map("companies")
}

enum CompanySize {
  TPE
  PME
  ETI
  GE
}

enum AccountingZone {
  FRANCE
  OHADA
  IFRS
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

// ─────────────────────────────────────────
// MEMBRES D'UNE ENTREPRISE
// ─────────────────────────────────────────

model CompanyMember {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId       String        @map("role_id")
  role         CompanyRole   @relation(fields: [roleId], references: [id])
  status       UserStatus    @default(ACTIVE)
  agenceMembers AgenceMember[]
  invitedBy String?    @map("invited_by")
  invitedAt DateTime?  @map("invited_at")
  joinedAt  DateTime?  @map("joined_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([companyId, userId])
  @@index([companyId])
  @@map("company_users")
}

model Invitation {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String
  roleId       String    @map("role_id")
  token        String    @unique
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  // Agence assignment — stored at invite time and applied on accept
  agenceIds    String[]  @default([]) @map("agence_ids")
  isRestricted Boolean   @default(false) @map("is_restricted")

  @@index([token])
  @@index([companyId])
  @@map("invitations")
}

// ─────────────────────────────────────────
// CABINET COMPTABLE
// ─────────────────────────────────────────

model Cabinet {
  id        String    @id @default(cuid())

  nom       String    @map("name")
  siret     String?   @unique

  companies           Company[]
  mandats             Mandat[]
  users               User[]
  cabinetInvitations  CabinetInvitation[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("cabinets")
}

model Mandat {
  id        String     @id @default(cuid())
  cabinetId String     @map("cabinet_id")
  cabinet   Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type      MandatType @default(COMPLET)
  modules   String[]   @default([])

  actif     Boolean    @default(true)

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([cabinetId, companyId])
  @@index([cabinetId])
  @@index([companyId])
  @@map("mandats")
}

enum MandatType {
  COMPLET
  COMPTABILITE
  GESTION
  DECLARATIONS
}

// ─────────────────────────────────────────
// EXERCICES COMPTABLES
// ─────────────────────────────────────────

model FiscalYear {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  status         FiscalYearStatus @default(OPEN)
  closedBy       String?          @map("closed_by")
  closedAt       DateTime?        @map("closed_at")
  createdBy      String           @map("created_by")
  openingBalance Json?            @map("opening_balance")
  closingBalance Json?            @map("closing_balance")

  journalEntries  JournalEntry[]
  taxDeclarations TaxDeclaration[]
  accountReviews  AccountReview[]
  depreciations   AssetDepreciation[]
  invoices        Invoice[]
  expenses        Expense[]
  purchaseOrders  PurchaseOrder[]
  vatDeclarations VatDeclaration[]
  payrolls        Payroll[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([companyId, year])
  @@index([companyId, status])
  @@map("fiscal_years")
}

enum FiscalYearStatus {
  DRAFT
  OPEN
  LOCKED
  CLOSED
}

// ─────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────

model Client {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nom            String  @map("name")
  email          String?
  telephone      String? @map("phone")
  adresse        String? @map("address")
  siren          String?
  // Compte comptable client (411xxx) — auto-généré ou saisi à la création.
  // Synchronisé avec AccountPlan via ensureAccountInPlan.
  accountingCode String? @map("accounting_code")
  isActive       Boolean @default(true) @map("is_active")

  invoices          Invoice[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("clients")
}

// ─────────────────────────────────────────
// FACTURES
// ─────────────────────────────────────────

model Invoice {
  id           String        @id @default(cuid())
  companyId    String        @map("company_id")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId     String        @map("client_id")
  client       Client        @relation(fields: [clientId], references: [id])
  fiscalYearId String?       @map("fiscal_year_id")
  fiscalYear   FiscalYear?   @relation(fields: [fiscalYearId], references: [id])
  agenceId     String?       @map("agence_id")
  agence       Agence?       @relation(fields: [agenceId], references: [id])

  reference          String        @map("number")
  modele             String        @default("standard")
  status             InvoiceStatus @default(DRAFT)
  amountHT           Decimal       @db.Decimal(12, 2) @map("subtotal")
  vatRate            Decimal       @db.Decimal(5, 2) @default(20) @map("tax_rate")
  amountTTC          Decimal       @db.Decimal(12, 2) @map("total")
  taxAmount          Decimal       @db.Decimal(12, 2) @map("tax_amount")
  issuedAt           DateTime      @map("issue_date")
  dueAt              DateTime      @map("due_date")
  paidAt             DateTime?     @map("paid_at")
  description        String?       @map("notes")
  conditionsPaiement String?       @map("conditions_paiement")
  // Comptabilisation : pièce générée dans le journal VTE quand statut → SENT
  posted             Boolean       @default(false)
  postedPieceId      String?       @map("posted_piece_id")
  postedAt           DateTime?     @map("posted_at")

  lines              InvoiceLine[]
  quoteId            String?          @unique @map("quote_id")
  recurringInvoiceId String?          @map("recurring_invoice_id")
  attachments        Attachment[]
  bankTransactions   BankTransaction[]
  quote              Quote?           @relation(fields: [quoteId], references: [id])
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([clientId])
  @@index([agenceId])
  @@map("invoices")
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String   @map("invoice_id")
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Article référencé (déclenche mouvement de stock SORTIE_VENTE à la comptabilisation)
  articleId     String?  @map("article_id")
  article       Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  description   String
  quantite      Decimal  @db.Decimal(10, 3) @default(1)
  unite         String   @default("pièce")
  prixUnitaireHT Decimal @db.Decimal(12, 2) @map("prix_unitaire_ht")
  tvaRate       Decimal  @db.Decimal(5, 2) @default(0) @map("tva_rate")
  montantHT     Decimal  @db.Decimal(12, 2) @map("montant_ht")
  // Compte de produit (7xx) — si nul, prend Article.compteVente puis 706 par défaut
  compteVente   String?  @map("compte_vente")

  @@index([invoiceId])
  @@index([articleId])
  @@map("invoice_lines")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TreasurySourceType {
  banque
  caisse
  mobile_money

  @@map("TreasurySourceType")
}

enum TreasuryEntryStatus {
  a_traiter
  traite

  @@map("TreasuryEntryStatus")
}

model TreasuryEntry {
  id         String              @id @default(cuid())
  companyId  String              @map("company_id")
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId   String?             @map("agence_id")
  agence     Agence?             @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  date       DateTime
  libelle    String
  montant    Decimal             @db.Decimal(12, 2)
  sourceType TreasurySourceType  @map("source_type")
  sourceName String              @map("source_name")
  pieceName  String?             @map("piece_name")
  status     TreasuryEntryStatus @default(a_traiter)
  /// Contrepartie comptable saisie lors de la validation (accountCode, accountLabel, libelle, addedAt)
  contrepartie Json?
  /// Pièces justificatives additionnelles ajoutées au moment de la validation
  extraPieces  Json?              @map("extra_pieces")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([companyId])
  @@index([agenceId])
  @@index([companyId, sourceName])
  @@map("treasury_entries")
}

// Sources de trésorerie persistées (comptes bancaires, caisses, portefeuilles
// mobile money). Une table unique avec un champ `type` pour distinguer les 3
// natures — les colonnes spécifiques à un type sont nullable.
model TreasurySource {
  id              String             @id @default(cuid())
  companyId       String             @map("company_id")
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId        String?            @map("agence_id")
  agence          Agence?            @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  type            TreasurySourceType
  /// Nom affiché (ex: "BICEC compte courant", "Caisse principale")
  nom             String
  /// Solde courant — recalculé à chaque opération ; init au solde d'ouverture
  solde           Decimal            @db.Decimal(15, 2) @default(0)
  devise          String             @default("XAF")
  // ── Banque-specific ───────────────────────────────────────────────────
  banque          String?
  numero          String?            // IBAN ou numéro de compte
  // ── Caisse-specific ───────────────────────────────────────────────────
  responsable     String?
  // ── Mobile Money-specific ─────────────────────────────────────────────
  operateur       String?            // 'MTN' | 'Orange Money' | 'Wave' …
  numeroTelephone String?            @map("numero_telephone")
  // ── Métadonnées ───────────────────────────────────────────────────────
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt      @map("updated_at")

  @@index([companyId, type])
  @@index([agenceId])
  @@map("treasury_sources")
}

// ─────────────────────────────────────────
// DÉPENSES
// ─────────────────────────────────────────

model Expense {
  id           String          @id @default(cuid())
  companyId    String          @map("company_id")
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String?         @map("fiscal_year_id")
  fiscalYear   FiscalYear?     @relation(fields: [fiscalYearId], references: [id])
  agenceId     String?         @map("agence_id")
  agence       Agence?         @relation(fields: [agenceId], references: [id])

  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  date         DateTime
  receiptUrl   String?         @map("receipt_url")

  attachments      Attachment[]
  bankTransactions BankTransaction[]

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([companyId, date])
  @@index([agenceId])
  @@map("expenses")
}

enum ExpenseCategory {
  TRAVEL
  EQUIPMENT
  SOFTWARE
  SALARY
  RENT
  MARKETING
  CONSULTING
  OTHER
}

// ─────────────────────────────────────────
// RH — EMPLOYÉS
// ─────────────────────────────────────────

model Employee {
  id             String         @id @default(cuid())
  companyId      String         @map("company_id")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nom            String         @map("last_name")
  prenom         String         @map("first_name")
  email          String
  telephone      String?        @map("phone")
  contrat        EmploymentType @map("employment_type")
  salaireBrut    Decimal        @db.Decimal(12, 2) @map("gross_salary")
  dateEmbauche   DateTime       @map("start_date")
  dateFinContrat DateTime?      @map("end_date")

  // ── Moyens de paiement ─────────────────────────────────────────────────
  paymentMethod          PaymentMethod? @map("payment_method")
  // Mobile Money (Orange Money, MTN MoMo, Express Union…)
  mobileMoneyNumber      String?        @map("mobile_money_number")
  mobileMoneyProvider    String?        @map("mobile_money_provider")  // ORANGE, MTN, EU, etc.
  // Compte bancaire
  bankName               String?        @map("bank_name")
  bankAccountHolder      String?        @map("bank_account_holder")
  bankAccountNumber      String?        @map("bank_account_number")    // RIB / IBAN
  bankSwiftCode          String?        @map("bank_swift_code")

  // ── Compte comptable de tiers (422xxxxx) ──────────────────────────────
  accountingCode         String?        @map("accounting_code")

  // ── Métadonnées organisationnelles ─────────────────────────────────────
  poste          String?        // ex: "Comptable senior"
  departement    String?        // ex: "Finance"
  managerId      String?        @map("manager_id")
  manager        Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates   Employee[]     @relation("EmployeeManager")

  annualReviews       AnnualReview[]
  leaveRequests       LeaveRequest[]
  workSchedules       WorkSchedule[]
  employmentContracts EmploymentContract[]

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([managerId])
  @@map("employees")
}

// ── Contrats d'emploi (CDI, CDD, stages, temps partiel) ─────────────────────
enum EmploymentContractStatus {
  DRAFT
  SIGNED
  TERMINATED

  @@map("EmploymentContractStatus")
}

model EmploymentContract {
  id            String                   @id @default(cuid())
  companyId     String                   @map("company_id")
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String                   @map("employee_id")
  employee      Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType  EmploymentType           @map("contract_type")
  status        EmploymentContractStatus @default(DRAFT)
  startDate     DateTime                 @map("start_date")
  endDate       DateTime?                @map("end_date")
  grossSalary   Decimal                  @db.Decimal(12, 2) @map("gross_salary")
  poste         String
  departement   String
  lieuTravail   String                   @map("lieu_travail")
  /// Texte complet du contrat — modifiable jusqu'à signature
  content       String                   @db.Text
  signedAt      DateTime?                @map("signed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("employment_contracts")
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CHECK
}

// ─────────────────────────────────────────
// PAIE — Lots mensuels
// ─────────────────────────────────────────

enum PayrollStatus {
  DRAFT       // Calculée, non comptabilisée
  POSTED      // Écritures journal PAY générées
  PAID        // Paiements effectués + trésorerie mouvementée
  SENT        // Bulletins envoyés par email
  CANCELLED
}

enum PayslipStatus {
  PENDING
  PAID
  FAILED
}

model Payroll {
  id                  String        @id @default(cuid())
  companyId           String        @map("company_id")
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId        String?       @map("fiscal_year_id")
  fiscalYear          FiscalYear?   @relation(fields: [fiscalYearId], references: [id])

  // Période traitée
  month               Int           // 1-12
  year                Int

  status              PayrollStatus @default(DRAFT)

  // Comptabilisation
  postedPieceId       String?       @map("posted_piece_id")
  postedAt            DateTime?     @map("posted_at")
  journalCode         String        @default("PAY") @map("journal_code")

  // Paiements
  treasuryAccount     String?       @map("treasury_account")   // 521xxxxx par défaut
  paidAt              DateTime?     @map("paid_at")

  // Email
  sentAt              DateTime?     @map("sent_at")

  // Totaux
  totalGross          Decimal       @db.Decimal(15, 2) @default(0) @map("total_gross")
  totalNet            Decimal       @db.Decimal(15, 2) @default(0) @map("total_net")
  totalCnpsSal        Decimal       @db.Decimal(15, 2) @default(0) @map("total_cnps_sal")
  totalCnpsEmp        Decimal       @db.Decimal(15, 2) @default(0) @map("total_cnps_emp")
  totalIrpp           Decimal       @db.Decimal(15, 2) @default(0) @map("total_irpp")
  totalCac            Decimal       @db.Decimal(15, 2) @default(0) @map("total_cac")
  employeesCount      Int           @default(0) @map("employees_count")

  notes               String?
  createdBy           String?       @map("created_by")

  payslips            Payslip[]

  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("payrolls")
}

model Payslip {
  id                  String         @id @default(cuid())
  payrollId           String         @map("payroll_id")
  payroll             Payroll        @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId          String         @map("employee_id")
  employeeName        String         @map("employee_name")
  employeeEmail       String?        @map("employee_email")
  employmentType     EmploymentType  @map("employment_type")

  // Données du mois
  daysWorked          Int            @default(30) @map("days_worked")
  daysAbsentUnpaid    Int            @default(0) @map("days_absent_unpaid")

  // Calculs (denormalisés)
  grossSalary         Decimal        @db.Decimal(15, 2) @map("gross_salary")
  cnpsSal             Decimal        @db.Decimal(15, 2) @default(0) @map("cnps_sal")
  cnpsEmp             Decimal        @db.Decimal(15, 2) @default(0) @map("cnps_emp")
  irpp                Decimal        @db.Decimal(15, 2) @default(0)
  cac                 Decimal        @db.Decimal(15, 2) @default(0)
  netToPay            Decimal        @db.Decimal(15, 2) @map("net_to_pay")
  totalCost           Decimal        @db.Decimal(15, 2) @map("total_cost")

  // Paiement
  paymentMethod       PaymentMethod? @map("payment_method")
  paymentRef          String?        @map("payment_ref")
  paymentStatus       PayslipStatus  @default(PENDING) @map("payment_status")
  paidAt              DateTime?      @map("paid_at")

  // Communication
  emailSentAt         DateTime?      @map("email_sent_at")

  createdAt           DateTime       @default(now()) @map("created_at")

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

// ─────────────────────────────────────────
// COMPTABILITÉ — JOURNAL
// ─────────────────────────────────────────

model JournalEntry {
  id           String     @id @default(cuid())
  companyId    String     @map("company_id")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String     @map("fiscal_year_id")
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  date         DateTime
  journal      String     @map("journal_code")
  pieceId      String?    @map("piece_id")
  compte       String     @map("account")
  libelle      String     @map("label")
  debit        Decimal    @db.Decimal(12, 2) @default(0)
  credit       Decimal    @db.Decimal(12, 2) @default(0)
  reference    String?
  lettrage     String?
  invoiceId    String?    @map("invoice_id")
  expenseId    String?    @map("expense_id")
  // Pièce justificative — toutes les lignes d'un même pieceId partagent la même PJ
  pieceUrl     String?    @map("piece_url")
  pieceName    String?    @map("piece_name")
  createdBy    String?    @map("created_by")

  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([companyId, fiscalYearId])
  @@index([compte])
  @@index([pieceId])
  @@map("journal_entries")
