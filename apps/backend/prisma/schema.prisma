// ─────────────────────────────────────────
// BONS DE COMMANDE FOURNISSEURS (ACHATS)
// ─────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIAL
  CANCELLED
}

enum PurchaseDocumentType {
  ORDER     // Bon de commande — généré par nous (référence auto-incrémentée)
  INVOICE   // Facture d'achat — reçue du fournisseur (référence saisie manuellement)
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String              @map("company_id")
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agenceId     String?             @map("agence_id")
  agence       Agence?             @relation(fields: [agenceId], references: [id])
  fiscalYearId String?             @map("fiscal_year_id")
  fiscalYear   FiscalYear?         @relation(fields: [fiscalYearId], references: [id])

  reference    String              @map("number")
  // Type de document : ORDER = bon de commande (généré par nous), INVOICE = facture d'achat
  // (reçue du fournisseur — référence saisie manuellement, pas d'auto-incrément)
  documentType PurchaseDocumentType @default(ORDER) @map("document_type")
  fournisseur  String              // Nom textuel du fournisseur
  // Compte comptable fournisseur (401xxx) — auto-créé dans AccountPlan si nouveau
  supplierAccount String?          @map("supplier_account")
  objet        String
  status       PurchaseOrderStatus @default(DRAFT)
  date         DateTime
  receptionAt  DateTime?           @map("reception_at")
  montantHT    Decimal             @db.Decimal(12, 2) @map("montant_ht")
  vatRate      Decimal             @db.Decimal(5, 2) @default(0) @map("vat_rate")
  montantTTC   Decimal             @db.Decimal(12, 2) @map("montant_ttc")
  conditionsPaiement String?       @map("conditions_paiement")
  notes        String?
  // Pièce justificative — fichier de la facture fournisseur uploadée ultérieurement
  pieceUrl     String?             @map("piece_url")
  pieceName    String?             @map("piece_name")
  // Comptabilisation : pièce générée dans le journal ACH quand validée
  posted          Boolean          @default(false)
  postedPieceId   String?          @map("posted_piece_id")
  postedAt        DateTime?        @map("posted_at")

  lines        PurchaseOrderLine[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([agenceId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id             String        @id @default(cuid())
  orderId        String        @map("order_id")
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Article référencé (déclenche mouvement de stock ENTREE_ACHAT à la comptabilisation)
  articleId      String?       @map("article_id")
  article        Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull)
  reference      String?
  designation    String
  quantite       Decimal       @db.Decimal(10, 3)
  unite          String        @default("pièce")
  prixUnitaireHT Decimal       @db.Decimal(12, 2) @map("prix_unitaire_ht")
  montantHT      Decimal       @db.Decimal(12, 2) @map("montant_ht")
  // Compte de charge (6xx) — si nul, prend Article.compteAchat puis 604 par défaut
  compteAchat    String?       @map("compte_achat")

  @@index([orderId])
  @@index([articleId])
  @@map("purchase_order_lines")
}

