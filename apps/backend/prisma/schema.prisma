  centerImpots       String?   @map("center_impots")
  niu                String?
  rccm               String?
  professionLiberale Boolean   @default(false) @map("profession_liberale")
  cnpsRate           Decimal   @db.Decimal(6, 4) @default(0.172) @map("cnps_rate")
  igsClass           Int?      @map("igs_class")
  igsAmount          Decimal?  @db.Decimal(15, 2) @map("igs_amount")
  regimeHistory      Json?     @map("regime_history")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("tax_configs")
}

model TaxDeclaration {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId  String?       @map("fiscal_year_id")
  fiscalYear    FiscalYear?   @relation(fields: [fiscalYearId], references: [id])

  type          TaxType
  period        String
  year          Int
  month         Int?
  baseAmount    Decimal       @db.Decimal(14, 2) @map("base_amount")
  taxAmount     Decimal       @db.Decimal(14, 2) @map("tax_amount")
  status        TaxDeclStatus @default(PENDING)
  dueDate       DateTime      @map("due_date")
  declaredAt    DateTime?     @map("declared_at")
  paidAt        DateTime?     @map("paid_at")
  penaltyAmount Decimal       @db.Decimal(14, 2) @default(0) @map("penalty_amount")
  reference     String?

  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([companyId, type, year])
  @@map("tax_declarations")
}

enum TaxRegime {
  IGS
