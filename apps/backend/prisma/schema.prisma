generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum AccountType {
  PERSONAL
  COMPANY
  CABINET
}

enum Role {
  ADMIN
  COMPTABLE
  READONLY
  RH
  JURIDIQUE
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

enum CompanySize {
  TPE
  PME
  ETI
  GE
}

enum MandatType {
  COMPLET
  COMPTABILITE
  GESTION
  DECLARATIONS
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  TRAVEL
  EQUIPMENT
  SOFTWARE
  SALARY
  RENT
  MARKETING
  CONSULTING
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_FAILED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  TOKEN_REFRESHED
  TOKEN_REVOKED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_DELETED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  CLIENT_CREATED
  CLIENT_UPDATED
  EMPLOYEE_CREATED
  DATA_EXPORTED
  CABINET_ACCESS
  MANDAT_CREATED
  MANDAT_REVOKED
  COMPANY_INVITED
}

// ── Cabinet ───────────────────────────────────────────────────────────────────

model Cabinet {
  id        String   @id @default(cuid())
  name      String
  siret     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users   User[]
  clients Company[]
  mandats Mandat[]

  @@map("cabinets")
}

// ── Company ───────────────────────────────────────────────────────────────────

model Company {
  id        String      @id @default(cuid())
  name      String
  siren     String?     @unique
  secteur   String?
  taille    CompanySize @default(PME)
  plan      Plan        @default(FREE)
  modules   String[]    @default([])
  cabinetId String?     @map("cabinet_id")
  cabinet   Cabinet?    @relation(fields: [cabinetId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  users     User[]
  clients   Client[]
  invoices  Invoice[]
  expenses  Expense[]
  employees Employee[]
  esgData   ESGData[]
  mandats   Mandat[]

  @@index([cabinetId])
  @@map("companies")
}

// ── User ──────────────────────────────────────────────────────────────────────

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String      @map("password_hash")
  accountType         AccountType @map("account_type")
  role                Role        @default(READONLY)
  firstName           String?     @map("first_name")
  lastName            String?     @map("last_name")
  isActive            Boolean     @default(true) @map("is_active")
  companyId           String?     @map("company_id")
  company             Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cabinetId           String?     @map("cabinet_id")
  cabinet             Cabinet?    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  totpSecret          String?     @map("totp_secret")
  totpEnabled         Boolean     @default(false) @map("totp_enabled")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until")
  lastLoginAt         DateTime?   @map("last_login_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
  @@index([cabinetId])
  @@map("users")
}

// ── Mandat ────────────────────────────────────────────────────────────────────

model Mandat {
  id        String     @id @default(cuid())
  cabinetId String     @map("cabinet_id")
  cabinet   Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      MandatType
  modules   String[]
  actif     Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([cabinetId, companyId])
  @@index([cabinetId])
  @@index([companyId])
  @@map("mandats")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────

model RefreshToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String?   @map("replaced_by_hash")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Business models ───────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  siren     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([companyId])
  @@map("clients")
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  companyId String        @map("company_id")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String        @map("client_id")
  client    Client        @relation(fields: [clientId], references: [id])
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @map("issue_date")
  dueDate   DateTime      @map("due_date")
  subtotal  Decimal       @db.Decimal(12, 2)
  taxRate   Decimal       @default(20) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount Decimal       @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal       @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model Expense {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String
  date        DateTime
  receiptUrl  String?         @map("receipt_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([date])
  @@map("expenses")
}

model Employee {
  id             String         @id @default(cuid())
  companyId      String         @map("company_id")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  employmentType EmploymentType @map("employment_type")
  grossSalary    Decimal        @map("gross_salary") @db.Decimal(12, 2)
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("employees")
}

model ESGData {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year          Int
  co2Emissions  Decimal? @map("co2_emissions") @db.Decimal(10, 2)
  energyKwh     Decimal? @map("energy_kwh") @db.Decimal(12, 2)
  wasteKg       Decimal? @map("waste_kg") @db.Decimal(10, 2)
  genderPayGap  Decimal? @map("gender_pay_gap") @db.Decimal(5, 2)
  trainingHours Decimal? @map("training_hours") @db.Decimal(8, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([companyId, year])
  @@index([companyId])
  @@map("esg_data")
}

// ── AuditLog ──────────────────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cabinetUserId String?     @map("cabinet_user_id")
  companyId     String?     @map("company_id")
  action        AuditAction
  resource      String?
  resourceId    String?     @map("resource_id")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
