generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum AccountType {
  PERSONAL
  COMPANY
  CABINET
}

enum Role {
  ADMIN
  COMPTABLE
  READONLY
  RH
  JURIDIQUE
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

enum CompanySize {
  TPE
  PME
  ETI
  GE
}

enum MandatType {
  COMPLET
  COMPTABILITE
  GESTION
  DECLARATIONS
}

enum AccountingZone {
  FRANCE
  OHADA
  IFRS
}

enum ChartAccountType {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum LeaveType {
  CP
  RTT
  SICK
  MATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BankTxType {
  CREDIT
  DEBIT
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum ExpenseCategory {
  TRAVEL
  EQUIPMENT
  SOFTWARE
  SALARY
  RENT
  MARKETING
  CONSULTING
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum ContractType {
  EMPLOYMENT
  SERVICE
  NDA
  PARTNERSHIP
  LEASE
  SUPPLIER
  CLIENT
  OTHER
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  EXPIRED
  TERMINATED
}

enum SignatureStatus {
  PENDING
  SIGNED
  REFUSED
}

enum GdprLegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  VITAL_INTEREST
  PUBLIC_TASK
  LEGITIMATE_INTEREST
}

enum GdprRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_FAILED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  TOKEN_REFRESHED
  TOKEN_REVOKED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_DELETED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  CLIENT_CREATED
  CLIENT_UPDATED
  EMPLOYEE_CREATED
  DATA_EXPORTED
  CABINET_ACCESS
  MANDAT_CREATED
  MANDAT_REVOKED
  COMPANY_INVITED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum FiscalYearStatus {
  DRAFT
  OPEN
  LOCKED
  CLOSED
}

enum TaxRegime {
  IGS               // Impôt Général Synthétique (CA < 50M, libératoire)
  REEL_NORMAL       // CA ≥ 50M ou profession libérale
  REEL_SIMPLIFIE    // CA 10M–50M (option)
  FORFAIT_BIENNAL   // Legacy (< 2025)
  MICRO_ENTREPRISE  // Legacy
  LIBERATOIRE       // Ancien régime (< 2025)
}

enum VatRegime {
  MENSUEL
  TRIMESTRIEL
  NON_ASSUJETTI
}

enum IgsPayment {
  ANNUEL
  TRIMESTRIEL
}

enum TaxType {
  TVA
  IS
  IS_ACOMPTE
  PATENTE
  RAS
  CNPS
  FDFP
  DSF
}

enum TaxDeclStatus {
  PENDING
  DECLARED
  PAID
  LATE
  EXEMPTED
}

// ── Cabinet ───────────────────────────────────────────────────────────────────

model Cabinet {
  id        String   @id @default(cuid())
  name      String
  siret     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users   User[]
  clients Company[]
  mandats Mandat[]

  @@map("cabinets")
}

// ── Company ───────────────────────────────────────────────────────────────────

model Company {
  id        String      @id @default(cuid())
  name      String
  siren     String?     @unique
  secteur   String?
  taille    CompanySize @default(PME)
  plan           Plan           @default(FREE)
  modules        String[]       @default([])
  country        String         @default("FR")
  currency       String         @default("EUR")
  currencySymbol String         @default("€")          @map("currency_symbol")
  accountingZone AccountingZone @default(FRANCE)       @map("accounting_zone")
  accountingPlan String         @default("PCG")        @map("accounting_plan")
  vatRates       Json?          @map("vat_rates")
  locale         String         @default("fr-FR")
  timezone       String         @default("Europe/Paris")
  cabinetId      String?        @map("cabinet_id")
  cabinet   Cabinet?    @relation(fields: [cabinetId], references: [id])

  // ── Identity & legal ──────────────────────────────────────────────────────
  logo           String?
  legalForm      String?   @map("legal_form")
  siret          String?
  naf            String?
  vatNumber      String?   @map("vat_number")
  capital        Decimal?  @db.Decimal(18, 2)
  address        String?
  postalCode     String?   @map("postal_code")
  city           String?
  phone          String?
  contactEmail   String?   @map("contact_email")
  website        String?

  // ── Appearance ────────────────────────────────────────────────────────────
  primaryColor   String?   @map("primary_color")
  secondaryColor String?   @map("secondary_color")
  font           String?

  // ── Invoice defaults ──────────────────────────────────────────────────────
  invoiceMentions   String?   @map("invoice_mentions") @db.Text
  paymentTerms      Int?      @map("payment_terms")
  lateInterestRate  Decimal?  @map("late_interest_rate") @db.Decimal(6, 4)
  discountRate      Decimal?  @map("discount_rate") @db.Decimal(6, 4)

  // ── Security policy ───────────────────────────────────────────────────────
  securityPolicy Json?  @map("security_policy")

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  users             User[]
  clients           Client[]
  invoices          Invoice[]
  expenses          Expense[]
  employees         Employee[]
  esgData           ESGData[]
  mandats           Mandat[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]
  bankTransactions  BankTransaction[]
  fiscalYearCloses  FiscalYearClose[]
  leaveRequests     LeaveRequest[]
  annualReviews     AnnualReview[]
  workSchedules     WorkSchedule[]
  legalContracts    LegalContract[]
  gdprEntries       GdprEntry[]
  legalAlerts       LegalAlert[]
  esgActions        EsgAction[]
  aiConversations   AiConversation[]
  accountPlans      AccountPlan[]
  attachments       Attachment[]
  companyRoles      CompanyRole[]
  companyUsers      CompanyUser[]
  invitations       Invitation[]
  fiscalYears       FiscalYear[]
  journalEntries    JournalEntry[]
  vatDeclarations   VATDeclaration[]
  taxConfig         TaxConfig?
  taxDeclarations   TaxDeclaration[]

  @@index([cabinetId])
  @@map("companies")
}

// ── User ──────────────────────────────────────────────────────────────────────

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String      @map("password_hash")
  accountType         AccountType @map("account_type")
  role                Role        @default(READONLY)
  firstName           String?     @map("first_name")
  lastName            String?     @map("last_name")
  isActive            Boolean     @default(true) @map("is_active")
  companyId           String?     @map("company_id")
  company             Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cabinetId           String?     @map("cabinet_id")
  cabinet             Cabinet?    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  totpSecret          String?     @map("totp_secret")
  totpEnabled         Boolean     @default(false) @map("totp_enabled")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until")
  lastLoginAt         DateTime?   @map("last_login_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  companyUsers  CompanyUser[]

  @@index([companyId])
  @@index([cabinetId])
  @@map("users")
}

// ── Mandat ────────────────────────────────────────────────────────────────────

model Mandat {
  id        String     @id @default(cuid())
  cabinetId String     @map("cabinet_id")
  cabinet   Cabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      MandatType
  modules   String[]
  actif     Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([cabinetId, companyId])
  @@index([cabinetId])
  @@index([companyId])
  @@map("mandats")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────

model RefreshToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String?   @map("replaced_by_hash")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Business models ───────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  siren     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices          Invoice[]
  quotes            Quote[]
  recurringInvoices RecurringInvoice[]

  @@index([companyId])
  @@map("clients")
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  companyId String        @map("company_id")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String        @map("client_id")
  client    Client        @relation(fields: [clientId], references: [id])
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @map("issue_date")
  dueDate   DateTime      @map("due_date")
  subtotal  Decimal       @db.Decimal(12, 2)
  taxRate   Decimal       @default(20) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount Decimal       @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal       @db.Decimal(12, 2)
  notes                String?
  quoteId              String?           @unique @map("quote_id")
  quote                Quote?            @relation(fields: [quoteId], references: [id])
  recurringInvoiceId   String?           @map("recurring_invoice_id")
  recurringInvoice     RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])
  paidAt               DateTime?         @map("paid_at")
  fiscalYearId         String?           @map("fiscal_year_id")
  fiscalYear           FiscalYear?       @relation(fields: [fiscalYearId], references: [id])
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  bankTransactions BankTransaction[]
  attachments      Attachment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([fiscalYearId])
  @@map("invoices")
}

model Quote {
  id         String      @id @default(cuid())
  number     String
  companyId  String      @map("company_id")
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId   String      @map("client_id")
  client     Client      @relation(fields: [clientId], references: [id])
  status     QuoteStatus @default(DRAFT)
  issueDate  DateTime    @map("issue_date")
  validUntil DateTime    @map("valid_until")
  subtotal   Decimal     @db.Decimal(12, 2)
  taxRate    Decimal     @default(20) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount  Decimal     @map("tax_amount") @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  invoice    Invoice?

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@map("quotes")
}

model RecurringInvoice {
  id          String             @id @default(cuid())
  companyId   String             @map("company_id")
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId    String             @map("client_id")
  client      Client             @relation(fields: [clientId], references: [id])
  frequency   RecurringFrequency
  subtotal    Decimal            @db.Decimal(12, 2)
  taxRate     Decimal            @default(20) @map("tax_rate") @db.Decimal(5, 2)
  notes       String?
  active      Boolean            @default(true)
  nextDueDate DateTime           @map("next_due_date")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([companyId])
  @@index([clientId])
  @@map("recurring_invoices")
}

model Expense {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String
  date        DateTime
  receiptUrl   String?         @map("receipt_url")
  fiscalYearId String?         @map("fiscal_year_id")
  fiscalYear   FiscalYear?     @relation(fields: [fiscalYearId], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  bankTransactions BankTransaction[]
  attachments      Attachment[]

  @@index([companyId])
  @@index([date])
  @@index([fiscalYearId])
  @@map("expenses")
}

model Employee {
  id             String         @id @default(cuid())
  companyId      String         @map("company_id")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  employmentType EmploymentType @map("employment_type")
  grossSalary    Decimal        @map("gross_salary") @db.Decimal(12, 2)
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]
  annualReviews AnnualReview[]
  workSchedules WorkSchedule[]

  @@index([companyId])
  @@map("employees")
}

model LeaveRequest {
  id         String      @id @default(cuid())
  companyId  String      @map("company_id")
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String      @map("employee_id")
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime    @map("start_date")
  endDate    DateTime    @map("end_date")
  days       Int
  status     LeaveStatus @default(PENDING)
  reason     String?
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model AnnualReview {
  id           String       @id @default(cuid())
  companyId    String       @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId   String       @map("employee_id")
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year         Int
  rating       Int?
  strengths    String?
  improvements String?
  objectives   Json?
  status       ReviewStatus @default(DRAFT)
  scheduledAt  DateTime?    @map("scheduled_at")
  completedAt  DateTime?    @map("completed_at")
  reviewerId   String?      @map("reviewer_id")
  notes        String?
  reviewedAt   DateTime?    @map("reviewed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, employeeId, year])
  @@index([companyId])
  @@index([employeeId])
  @@map("annual_reviews")
}

model WorkSchedule {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart  DateTime @map("week_start")
  monday     Json?
  tuesday    Json?
  wednesday  Json?
  thursday   Json?
  friday     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, employeeId, weekStart])
  @@index([companyId])
  @@index([employeeId])
  @@map("work_schedules")
}

enum EsgActionStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum EsgActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EsgPilier {
  E
  S
  G
}

model ESGData {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year          Int
  // Scope 1 — direct emissions (tCO2e)
  scope1Total   Decimal? @map("scope1_total") @db.Decimal(10, 2)
  scope1Details Json?    @map("scope1_details") // { naturalGas, fuelOil, vehicles, process }
  // Scope 2 — purchased electricity (tCO2e)
  scope2Total   Decimal? @map("scope2_total") @db.Decimal(10, 2)
  scope2Kwh     Decimal? @map("scope2_kwh") @db.Decimal(12, 2)
  // Scope 3 — value chain (tCO2e)
  scope3Total   Decimal? @map("scope3_total") @db.Decimal(10, 2)
  scope3Details Json?    @map("scope3_details") // { businessTravel, freight, waste, purchasedGoods }
  // Social
  energyKwh     Decimal? @map("energy_kwh") @db.Decimal(12, 2)
  wasteKg       Decimal? @map("waste_kg") @db.Decimal(10, 2)
  renewableRatio Decimal? @map("renewable_ratio") @db.Decimal(5, 2)
  genderPayGap  Decimal? @map("gender_pay_gap") @db.Decimal(5, 2)
  trainingHours Decimal? @map("training_hours") @db.Decimal(8, 2)
  absenteeismRate Decimal? @map("absenteeism_rate") @db.Decimal(5, 2)
  workplaceAccidents Int? @map("workplace_accidents")
  // Governance
  boardFemaleRatio Decimal? @map("board_female_ratio") @db.Decimal(5, 2)
  hasEthicsCode    Boolean  @default(false) @map("has_ethics_code")
  hasAnticorruption Boolean @default(false) @map("has_anticorruption")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([companyId, year])
  @@index([companyId])
  @@map("esg_data")
}

model EsgAction {
  id          String            @id @default(cuid())
  companyId   String            @map("company_id")
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  pilier      EsgPilier
  priority    EsgActionPriority @default(MEDIUM)
  status      EsgActionStatus   @default(TODO)
  targetYear  Int               @map("target_year")
  deadline    DateTime?
  owner       String?
  kpiTarget   String?           @map("kpi_target")
  kpiCurrent  String?           @map("kpi_current")
  co2Saving   Decimal?          @map("co2_saving") @db.Decimal(10, 2)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("esg_actions")
}

// ── Bank / Accounting ─────────────────────────────────────────────────────────

model BankTransaction {
  id         String               @id @default(cuid())
  companyId  String               @map("company_id")
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date       DateTime
  label      String
  amount     Decimal              @db.Decimal(12, 2)
  type       BankTxType
  reference  String?
  status     ReconciliationStatus @default(UNMATCHED)
  lettrage   String?
  invoiceId  String?              @map("invoice_id")
  invoice    Invoice?             @relation(fields: [invoiceId], references: [id])
  expenseId  String?              @map("expense_id")
  expense    Expense?             @relation(fields: [expenseId], references: [id])
  importedAt DateTime             @default(now()) @map("imported_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([companyId])
  @@index([date])
  @@index([status])
  @@map("bank_transactions")
}

model FiscalYearClose {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year        Int
  resultNet   Decimal  @map("result_net") @db.Decimal(12, 2)
  notes       String?
  closedBy    String?  @map("closed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([companyId, year])
  @@index([companyId])
  @@map("fiscal_year_closes")
}

// ── Juridique ─────────────────────────────────────────────────────────────────

model LegalContract {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  type        ContractType
  status      ContractStatus @default(DRAFT)
  parties     Json           // [{ name, email, role }]
  content     String?        @db.Text
  fileUrl     String?        @map("file_url")
  signedAt    DateTime?      @map("signed_at")
  expiresAt   DateTime?      @map("expires_at")
  terminatedAt DateTime?     @map("terminated_at")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  signatures  ContractSignature[]
  alerts      LegalAlert[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("legal_contracts")
}

model ContractSignature {
  id         String          @id @default(cuid())
  contractId String          @map("contract_id")
  contract   LegalContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerName  String         @map("signer_name")
  signerEmail String         @map("signer_email")
  signerRole  String?        @map("signer_role")
  status      SignatureStatus @default(PENDING)
  token       String         @unique
  signedAt    DateTime?      @map("signed_at")
  refusedAt   DateTime?      @map("refused_at")
  refusedNote String?        @map("refused_note")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([contractId])
  @@index([token])
  @@map("contract_signatures")
}

model GdprEntry {
  id               String         @id @default(cuid())
  companyId        String         @map("company_id")
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treatmentName    String         @map("treatment_name")
  purpose          String
  legalBasis       GdprLegalBasis @map("legal_basis")
  dataCategories   String[]       @map("data_categories")
  dataSubjects     String[]       @map("data_subjects")
  retentionMonths  Int            @map("retention_months")
  responsible      String
  subcontractors   String[]
  securityMeasures String[]       @map("security_measures")
  riskLevel        GdprRiskLevel  @default(LOW) @map("risk_level")
  dpiaRequired     Boolean        @default(false) @map("dpia_required")
  lastReviewedAt   DateTime?      @map("last_reviewed_at")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("gdpr_entries")
}

model LegalAlert {
  id          String        @id @default(cuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId  String?       @map("contract_id")
  contract    LegalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  message     String
  severity    AlertSeverity @default(INFO)
  status      AlertStatus   @default(OPEN)
  dueDate     DateTime?     @map("due_date")
  dismissedAt DateTime?     @map("dismissed_at")
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@index([severity])
  @@map("legal_alerts")
}

// ── AI Assistant ─────────────────────────────────────────────────────────────

model AiConversation {
  id        String      @id @default(cuid())
  companyId String      @map("company_id")
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String      @default("Nouvelle conversation")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  messages  AiMessage[]

  @@index([companyId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "user" | "assistant"
  content        String         @db.Text
  inputTokens    Int?           @map("input_tokens")
  outputTokens   Int?           @map("output_tokens")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_messages")
}

// ── Plan comptable ────────────────────────────────────────────────────────────

model AccountPlan {
  id        String           @id @default(cuid())
  companyId String           @map("company_id")
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numero    String
  intitule  String
  classe    Int
  type      ChartAccountType
  zone      AccountingZone
  isSystem  Boolean          @default(true) @map("is_system")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([companyId, numero])
  @@index([companyId, classe])
  @@map("account_plans")
}

// ── Attachments ───────────────────────────────────────────────────────────────

model Attachment {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  storageKey  String   @unique @map("storage_key")
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  invoiceId   String?  @map("invoice_id")
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expenseId   String?  @map("expense_id")
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([expenseId])
  @@index([companyId])
  @@map("attachments")
}

// ── AuditLog ──────────────────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cabinetUserId String?     @map("cabinet_user_id")
  companyId     String?     @map("company_id")
  action        AuditAction
  resource      String?
  resourceId    String?     @map("resource_id")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Settings — Roles & Users ───────────────────────────────────────────────────

model CompanyRole {
  id          String        @id @default(cuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean       @default(false) @map("is_system")
  permissions Json
  createdAt   DateTime      @default(now()) @map("created_at")

  users       CompanyUser[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("company_roles")
}

model CompanyUser {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String      @map("role_id")
  role        CompanyRole @relation(fields: [roleId], references: [id])
  status      UserStatus  @default(ACTIVE)
  invitedBy   String?     @map("invited_by")
  invitedAt   DateTime?   @map("invited_at")
  joinedAt    DateTime?   @map("joined_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([companyId, userId])
  @@index([companyId])
  @@map("company_users")
}

model Invitation {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  roleId      String    @map("role_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([companyId])
  @@map("invitations")
}

// ── Exercices comptables ───────────────────────────────────────────────────────

model FiscalYear {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  status         FiscalYearStatus @default(OPEN)
  openingBalance Json?            @map("opening_balance")
  closingBalance Json?            @map("closing_balance")
  createdBy      String           @map("created_by")
  closedBy       String?          @map("closed_by")
  closedAt       DateTime?        @map("closed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  entries         JournalEntry[]
  vatDeclarations VATDeclaration[]
  invoices        Invoice[]
  expenses        Expense[]

  @@unique([companyId, year])
  @@index([companyId, status])
  @@map("fiscal_years")
}

model JournalEntry {
  id           String     @id @default(cuid())
  companyId    String     @map("company_id")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String     @map("fiscal_year_id")
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  date         DateTime
  account      String
  label        String
  debit        Decimal    @default(0) @db.Decimal(12, 2)
  credit       Decimal    @default(0) @db.Decimal(12, 2)
  reference    String?
  journalCode  String     @default("OD") @map("journal_code")
  invoiceId    String?    @map("invoice_id")
  expenseId    String?    @map("expense_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([fiscalYearId])
  @@index([companyId])
  @@index([account])
  @@map("journal_entries")
}

model VATDeclaration {
  id            String     @id @default(cuid())
  companyId     String     @map("company_id")
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId  String     @map("fiscal_year_id")
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  quarter       Int
  year          Int
  tvaCollectee  Decimal    @db.Decimal(12, 2) @map("tva_collectee")
  tvaDeductible Decimal    @db.Decimal(12, 2) @map("tva_deductible")
  tvaNette      Decimal    @db.Decimal(12, 2) @map("tva_nette")
  status        String     @default("DRAFT")
  filedAt       DateTime?  @map("filed_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@unique([companyId, year, quarter])
  @@index([fiscalYearId])
  @@map("vat_declarations")
}

// ── Fiscalité ─────────────────────────────────────────────────────────────────

model TaxConfig {
  id                String     @id @default(cuid())
  companyId         String     @unique @map("company_id")
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country           String     @default("CM")

  // Régime fiscal
  taxRegime         TaxRegime  @default(REEL_NORMAL) @map("tax_regime")
  vatRegime         VatRegime  @default(MENSUEL) @map("vat_regime")
  isFirstYear       Boolean    @default(true) @map("is_first_year")
  firstYearCA       Decimal?   @db.Decimal(15, 2) @map("first_year_ca")

  // IGS spécifique
  igsClass          Int?       @map("igs_class")
  igsAmount         Decimal?   @db.Decimal(15, 2) @map("igs_amount")
  igsPaymentMode    IgsPayment? @map("igs_payment_mode")
  igsAdherentCga    Boolean    @default(false) @map("igs_adherent_cga")

  // Historique et alertes
  regimeHistory     Json?      @map("regime_history")
  regimeChangeAlert Boolean    @default(false) @map("regime_change_alert")
  lastRegimeCheck   DateTime?  @map("last_regime_check")
  nextRegimeCheck   DateTime?  @map("next_regime_check")

  // Identification fiscale
  centerImpots      String?    @map("center_impots")
  niu               String?
  rccm              String?
  codeActivite      String?    @map("code_activite")
  professionLiberale Boolean   @default(false) @map("profession_liberale")

  // Taux
  cnpsRate          Decimal    @default(0.172) @map("cnps_rate") @db.Decimal(6, 4)
  isRate            Decimal    @default(0.33) @map("is_rate") @db.Decimal(6, 4)
  vatRate           Decimal    @default(0.1925) @map("vat_rate") @db.Decimal(6, 4)
  isAssujetti       Boolean    @default(true) @map("is_assujetti")

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("tax_configs")
}

model IgsBareme {
  id          String   @id @default(cuid())
  classe      Int      @unique
  caMin       Decimal  @db.Decimal(15, 2) @map("ca_min")
  caMax       Decimal  @db.Decimal(15, 2) @map("ca_max")
  montantBase Decimal  @db.Decimal(15, 2) @map("montant_base")
  montantCga  Decimal  @db.Decimal(15, 2) @map("montant_cga")
  year        Int      @default(2026)

  @@map("igs_baremes")
}

model TaxDeclaration {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          TaxType
  period        String
  year          Int
  month         Int?
  quarter       Int?
  baseAmount    Decimal       @map("base_amount") @db.Decimal(14, 2)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(14, 2)
  status        TaxDeclStatus @default(PENDING)
  dueDate       DateTime      @map("due_date")
  declaredAt    DateTime?     @map("declared_at")
  paidAt        DateTime?     @map("paid_at")
  penaltyAmount Decimal       @default(0) @map("penalty_amount") @db.Decimal(14, 2)
  reference     String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([companyId, type, year])
  @@map("tax_declarations")
}

// ── AccountReview ─────────────────────────────────────────────────────────────

enum AccountReviewStatus {
  PENDING
  REVIEWED
  ANOMALY
}

model AccountReview {
  id                String              @id @default(cuid())
  companyId         String              @map("company_id")
  year              Int
  accountNumber     String              @map("account_number")
  cycle             Int
  status            AccountReviewStatus @default(PENDING)
  reviewedBy        String?             @map("reviewed_by")
  reviewedAt        DateTime?           @map("reviewed_at")
  note              String?
  anomalyNote       String?             @map("anomaly_note")
  anomalyResolvedAt DateTime?           @map("anomaly_resolved_at")
  resolutionNote    String?             @map("resolution_note")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([companyId, year, accountNumber])
  @@index([companyId, year, cycle])
  @@map("account_reviews")
}
