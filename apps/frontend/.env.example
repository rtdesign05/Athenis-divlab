# URL du backend Athenis
# - Pour le développement local, laisser vide (Vite proxie /api → localhost:3001)
# - Pour la production web (déploiement Nginx), laisser vide aussi
# - Pour Tauri Desktop ou Mobile, renseigner l'URL complète : https://ton-domaine.com/api
VITE_API_URL=

# Monitoring Sentry (optionnel)
VITE_SENTRY_DSN=

# Analytics PostHog (optionnel)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
